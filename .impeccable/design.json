  "narrative": {
    "northStar": "The Partner's Letter",
    "overview": "The pitch pages (/ and /recruiting) read like a letter from a partner at a serious firm. A strict 12-column grid, hairline rules, bond paper. A book serif speaks; a quiet grotesque does the work. Sections join on 1px ink rules into one continuous sheet.\n\nTwo blocks of ink carry the calls to act: the form panel in the first screen and the closing screen. Color is almost absent. Oxide appears only as small marks. The page is light only.\n\nIt rejects the SaaS landing page: no floating pill nav, no glow, no dashboard mock, no cards, no eyebrows above headings.",
    "keyCharacteristics": [
      "Serif headings; the turn of the sentence in italic.",
      "Square corners everywhere.",
      "The form lives in an ink panel in the first screen.",
      "One authored motion: contacts and the steps rule fill oxide as you scroll.",
      "Portraits in greyscale."
    ],
    "rules": [
      {
        "name": "The Small Mark Rule",
        "body": "Oxide never fills anything bigger than a dot, a line or a tag. If it covers an area, it is wrong.",
        "section": "colors"
      },
      {
        "name": "The Italic Turn Rule",
        "body": "A heading's `*punch*` is set in italic, same ink. No grey setup, no color.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every number that changes or lines up uses lining tabular figures.",
        "section": "typography"
      },
      {
        "name": "The Flat Sheet Rule",
        "body": "No shadows on anything that sits in the page.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do set headings in Newsreader with the punch in italic.",
      "Do keep oxide to dots, lines and tags.",
      "Do separate with 1px rules, not boxes.",
      "Do keep question 1 in the first phone screen."
    ],
    "donts": [
      "Don't add eyebrows or kickers above headings.",
      "Don't use cards, rounded corners, glow, gradients or glass.",
      "Don't fill a block or a resting button with oxide.",
      "Don't add a dark theme."
    ]
  }
