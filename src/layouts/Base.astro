---
// The layout for /agencies, /privacy and 404. Pitch pages (/, /recruiting/lead-reactivation) use Pitch.astro.
import '../styles/global.css';
import Head from '../components/Head.astro';
import Analytics from '../components/Analytics.astro';
const { title, description, hue, niche, image, noindex = false } = Astro.props as {
  title: string; description: string; hue: string; niche?: string; image?: string; noindex?: boolean;
};
---
<!doctype html>
<html lang="en" data-theme="dark" data-hue={hue} data-niche={niche}>
<head>
  <Head title={title} description={description} image={image} noindex={noindex} />
  <script is:inline>
    /* theme before first paint: the saved choice, else dark */
    try{var t=localStorage.getItem('wren-theme')||'dark';document.documentElement.dataset.theme=t}catch(e){}
    /* the hero draws itself the first time a tab opens each page. ?intro=1 forces it, ?intro=0 turns it off. Off for ?static, reduced motion and deep links. Set here so the first paint already hides what the intro reveals. */
    try{var p=new URLSearchParams(location.search),i=p.get('intro'),k='wren-intro:'+location.pathname,ok=!p.has('static')&&!p.has('sent')&&!location.hash&&!matchMedia('(prefers-reduced-motion: reduce)').matches;
    if(ok&&i===null&&!sessionStorage.getItem(k))i='2';
    if(ok&&i&&i!=='0'){document.documentElement.dataset.intro='2';sessionStorage.setItem(k,'1')}}catch(e){}
  </script>
</head>
<body>
  <slot />
  <script src="../scripts/motion.ts"></script>
  <script src="../scripts/hit.ts"></script>
  <Analytics />
</body>
</html>
