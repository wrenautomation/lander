---
// The hub, /: Wren as a whole. Copy from src/content/hub/home.yaml, the form's terms from its offer (lib/pitch.ts).
// Laid out on the B2B landing template, one screen per section, each ending on a button to the form:
// hero (words left, a line pointing at the form right), the pain (full-width headline, net margin by team size as a
// line chart, a bar on the gap), what moves the needle (six cards, each with a small animated scene), the five levels (building blocks: what each has and still lacks; this is how it works), client builds once there are real ones (each as the levels it climbed), every
// service, William, the comparison (each mark with why), questions, the recap, the sources every [^n] marker points at. Same type, colour and motion as the pitch pages (pitch.css, pitch.ts);
// hub.css adds the hub's own parts.
import '../styles/pitch.css';
import '../styles/hub.css';
import '../styles/cursor.css';
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';
import Head from '../components/Head.astro';
import Analytics from '../components/Analytics.astro';
import Consent from '../components/Consent.astro';
import Arrow from '../components/pitch/Arrow.astro';
import Apply from '../components/pitch/Apply.astro';
import Catalog from '../components/pitch/Catalog.astro';
import Mini from '../components/pitch/Mini.astro';
import Levels from '../components/pitch/Levels.astro';
import Values from '../components/pitch/Values.astro';
import Top from '../components/pitch/Top.astro';
import Loader from '../components/pitch/Loader.astro';
import Backdrop from '../components/pitch/Backdrop.astro';
import End from '../components/pitch/End.astro';
import { loadHub } from '../lib/pitch';
import { bare, rich, richParas } from '../lib/text';

const { entry } = Astro.props as { entry: CollectionEntry<'hub'> };
const { p, offer } = await loadHub(entry);
const { cases } = p;
const chart = p.pain.chart, pts = chart.points;
const STEP = 5, top = Math.ceil(Math.max(...pts.flatMap((x) => [x.pct, x.aim])) / STEP) * STEP; // the y axis runs 0 to top
const yTicks = Array.from({ length: top / STEP + 1 }, (_, i) => i * STEP);
const X = (k: number) => ((k + 0.5) / pts.length) * 100, Y = (v: number) => (v / top) * 100; // % across, % up
const line = (f: (x: typeof pts[number]) => number) => pts.map((x, k) => `${X(k)},${100 - Y(f(x))}`).join(' ');
const site = (await getEntry('site', 'site'))!.data;
const FONTS = 'https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600&display=swap';
const YES = 'M3.5 8.5l3 3 6-7', NO = 'M4.5 4.5l7 7M11.5 4.5l-7 7';
---
<!doctype html>
<html lang="en" class="pitch hub" data-niche={p.form_value}>
<head>
  <Head title={bare(p.title)} description={bare(p.description)} fonts={FONTS} theme="#ffffff" faq={p.faq.items} services={p.catalog.groups.flatMap((g) => g.items)} />
  <meta name="color-scheme" content="light">
  <script is:inline>
    /* motion on: the scroll-drawn parts start undrawn. Off for ?static and reduced motion, so the page reads as-is. */
    try{var q=new URLSearchParams(location.search),h=document.documentElement;if(!q.has('static')&&!matchMedia('(prefers-reduced-motion: reduce)').matches)h.classList.add('js')}catch(e){}
  </script>
</head>
<body>
<Loader />
<Backdrop />

<Top nav={p.nav} cta={p.nav_cta} hub contact={site.email} />

<main>
<section class="hero" id="top">
  <div class="wrap hero-grid hub-hero">
    <div class="copy">
      <p class="kicker"><i></i>{p.hero.proof}</p>
      <h1 set:html={rich(p.hero.h1)} />
      <div class="lede" set:html={richParas(p.hero.lede)} />
      <ul class="checks big">{p.hero.checks.map((c) => <li set:html={rich(c)} />)}</ul>
      <p class="to-form"><a href="#apply" data-cta><span>{p.hero.to_form}</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 8h10.5M9 4l4 4-4 4" /></svg></a></p>
    </div>
    <Apply a={p.ask} offer={offer} email={site.email} path={p.path} />
  </div>
</section>

<section class="sec pain-sec" id={p.pain.id}>
  <div class="wrap">
    <div class="grid">
      <div class="head">
        <h2 set:html={rich(p.pain.h2)} />
        <p class="punch" set:html={rich(p.pain.punch)} />
        <div class="intro" set:html={richParas(p.pain.text)} />
        <p class="fix" set:html={rich(p.pain.fix)} />
        <div class="act">
          <a class="btn" href="#apply" data-cta><span>{p.pain.cta}</span><Arrow /></a>
          <p class="assure">{p.pain.assure}</p>
        </div>
      </div>
      <figure class="window">
        <p class="hd">{chart.h}</p>
        <div class="art margin" data-art="margin" style={`--n:${pts.length}`}>
          <p class="ytitle" aria-hidden="true">{chart.y}</p>
          <div class="plot" role="img" aria-label={`${chart.h}: ${pts.map((x) => `${x.label} ${x.pct}%`).join(', ')}. ${chart.aim}: a far gentler fall.`}>
            {yTicks.map((t) => <span class="gl" style={`--y:${Y(t)}`} aria-hidden="true"><em>{t}%</em></span>)}
            <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
              <polyline class="real" points={line((x) => x.pct)} />
              <polyline class="aim" points={line((x) => x.aim)} />
            </svg>
            <i class="gap" style={`--x:${X(pts.length - 1)};--lo:${Y(pts.at(-1)!.pct)};--hi:${Y(pts.at(-1)!.aim)}`} aria-hidden="true"></i>
            {pts.map((x, k) => <i class="dot real" style={`--x:${X(k)};--y:${Y(x.pct)}`}><b>{x.pct}%</b></i>)}
            {pts.slice(1).map((x, k) => <i class="dot aim" style={`--x:${X(k + 1)};--y:${Y(x.aim)}`}></i>)}
          </div>
          <ul class="ticks" aria-hidden="true">{pts.map((x) => <li>{x.label}</li>)}</ul>
          <p class="axis">{chart.axis}</p>
          <ul class="key"><li class="real" set:html={rich(chart.real)} /><li class="aim">{chart.aim}</li></ul>
        </div>
      </figure>
    </div>
  </div>
</section>

<Values s={p.values} />

<Levels s={p.levels} face={p.about.photo} />

{cases && (
<section class="sec cases">
  <div class="wrap">
    <div class="head wide"><h2 set:html={rich(cases.h2)} /></div>
    <div class="case-list">
      {cases.items.map((c) => (
        <article class="case">
          <p class="who"><b>{c.client}</b><span>{c.kind}</span></p>
          <p class="climb" aria-label={`${p.levels.word} ${c.from} to ${p.levels.word} ${c.to}`}>
            <span>{p.levels.word} {c.from}</span>
            <span class="track" aria-hidden="true">{[1, 2, 3, 4, 5].map((k) => <i class:list={{ was: k <= c.from, gain: k > c.from && k <= c.to }}></i>)}</span>
            <span class="reached">{p.levels.word} {c.to}</span>
          </p>
          <dl>
            <div class="was"><dt>{cases.before}</dt><dd>{c.before}</dd></div>
            <div class="now"><dt>{cases.after}</dt><dd>{c.after}</dd></div>
          </dl>
        </article>
      ))}
    </div>
    <a class="btn" href="#apply" data-cta><span>{cases.cta}</span><Arrow /></a>
  </div>
</section>
)}

<Catalog s={p.catalog} />

<section class="sec about" id="about">
  <div class="wrap grid">
    <img class="photo" src={p.about.photo} alt={site.name} width="640" height="640" loading="lazy">
    <div class="head">
      <h2 set:html={rich(p.about.h2)} />
      {p.about.paras.map((x) => <p class="para" set:html={rich(x)} />)}
      {p.about.ideal && <div class="ideal"><p>{p.about.ideal.h}</p><ul>{p.about.ideal.items.map((t) => <li>{t}</li>)}</ul></div>}
      <div class="signoff">
        <p class="sign">{p.about.sign}</p>
        {p.about.cta && <a class="btn" href="#apply" data-cta><span>{p.about.cta}</span><Arrow /></a>}
      </div>
    </div>
    <div class="work" data-art="work">
      {p.about.work.map((w) => (
        <article>
          <p class="org">{w.org}</p>
          <h3>{w.title}</h3>
          <Mini in={w.in} out={w.out} />
          <div class="wfigs">{w.figs.map((f) => <p class="fig"><span class="n">{f.n}</span><small>{f.label}</small></p>)}</div>
        </article>
      ))}
      <p class="proves">{p.about.proves}</p>
    </div>
  </div>
</section>

<section class="sec compare" id={p.compare.id}>
  <div class="wrap">
    <div class="head wide"><h2 set:html={rich(p.compare.h2)} /></div>
    <div class="table" tabindex="0" role="region" aria-label="Comparison">
      <table>
        <thead><tr><th scope="col"><span class="sr">Feature</span></th><th scope="col" class="us">{p.compare.us}</th>{p.compare.them.map((t) => <th scope="col">{t}</th>)}</tr></thead>
        <tbody>
          {p.compare.rows.map((r) => (
            <tr>
              <th scope="row">{r.feature}</th>
              {r.cells.map(([m, why], k) => (
                <td class:list={{ us: k === 0 }}><span class="cell"><i class={m}><svg viewBox="0 0 16 16" aria-hidden="true"><path d={m === 'yes' ? YES : NO} /></svg><span class="sr">{m === 'yes' ? 'Yes.' : 'No.'}</span></i><small>{why}</small></span></td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <a class="btn" href="#apply" data-cta><span>{p.compare.cta}</span><Arrow /></a>
  </div>
</section>

<section class="sec faq" id="faq">
  <div class="wrap grid">
    <div class="head sticky"><h2 set:html={rich(p.faq.h2)} /></div>
    <div class="qa">
      {p.faq.items.map((x) => (
        <div><h3>{x.q}</h3><p set:html={rich(x.a)} /></div>
      ))}
    </div>
  </div>
</section>

<section class="close">
  <Backdrop dark="close" />
  <div class="wrap grid">
    <div class="head">
      <h2 set:html={rich(p.close.h2)} />
      {p.close.reason && <p class="reason" set:html={rich(p.close.reason)} />}
      <p>{p.close.text}</p>
    </div>
    {p.close.vs && (
      <div class="vs">
        <p class="hd win">{p.close.vs.win}</p><p class="hd lose">{p.close.vs.lose}</p>
        {p.close.vs.rows.map(([w, l]) => <><p class="win">{w}</p><p class="lose">{l}</p></>)}
      </div>
    )}
    <a class="btn" href="#apply" data-cta><span>{p.close.cta}</span><Arrow /></a>
  </div>
</section>

<section class="sources" id="sources">
  <div class="wrap">
    <h2>{p.sources.h}</h2>
    <ol>{p.sources.items.map((x, i) => <li id={`source-${i + 1}`}><a href={x.url} target="_blank" rel="noopener">{x.text}</a></li>)}</ol>
  </div>
</section>
</main>

<End site={site} />

<script src="../scripts/pitch.ts"></script>
<Consent />
<script src="../scripts/hit.ts"></script>
<Analytics />
</body>
</html>
