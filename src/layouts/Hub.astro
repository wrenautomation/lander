---
// The hub, /: Wren as a whole. Copy from src/content/hub/home.yaml, the form's terms from its offer (lib/pitch.ts).
// The first screen says what Wren builds and shows it (the firm map); every section after points into the services,
// and each service goes to its own page once it has one, else to the form at the bottom.
// Same type, colour and motion as the pitch pages (pitch.css, pitch.ts); hub.css adds the hub's own parts.
import '../styles/pitch.css';
import '../styles/hub.css';
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';
import Head from '../components/Head.astro';
import Analytics from '../components/Analytics.astro';
import Arrow from '../components/pitch/Arrow.astro';
import Steps from '../components/pitch/Steps.astro';
import Gantt from '../components/pitch/Gantt.astro';
import Apply from '../components/pitch/Apply.astro';
import FirmMap from '../components/pitch/FirmMap.astro';
import Top from '../components/pitch/Top.astro';
import End from '../components/pitch/End.astro';
import { loadHub } from '../lib/pitch';
import { bare, rich, richParas } from '../lib/text';

const { entry } = Astro.props as { entry: CollectionEntry<'hub'> };
const { p, offer } = await loadHub(entry);
const site = (await getEntry('site', 'site'))!.data;
const FONTS = 'https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600&display=swap';
// a link into the form counts as a CTA click (hit.ts); links to other pages don't
const cta = (to: string) => (to === '#apply' ? '' : undefined);
---
<!doctype html>
<html lang="en" class="pitch hub" data-niche={p.form_value}>
<head>
  <Head title={bare(p.title)} description={bare(p.description)} fonts={FONTS} theme="#ffffff" />
  <meta name="color-scheme" content="light">
  <script is:inline>
    /* motion on: the scroll-drawn parts start undrawn. Off for ?static and reduced motion, so the page reads as-is. */
    try{var q=new URLSearchParams(location.search),h=document.documentElement;if(!q.has('static')&&!matchMedia('(prefers-reduced-motion: reduce)').matches)h.classList.add('js')}catch(e){}
  </script>
</head>
<body>

<Top nav={p.nav} cta={p.nav_cta} hub />

<main>
<section class="hero" id="top">
  <div class="wrap hub-grid">
    <div class="copy">
      <h1 set:html={rich(p.hero.h1)} />
      <div class="lede" set:html={richParas(p.hero.lede)} />
      <p class="ctas">
        <a class="btn" href={p.hero.cta_to} data-cta={cta(p.hero.cta_to)}><span>{p.hero.cta}</span><Arrow /></a>
        <a class="second" href={p.hero.second_to} data-cta={cta(p.hero.second_to)}>{p.hero.second}</a>
      </p>
    </div>
    <FirmMap m={p.hero.map} />
    <p class="by">
      <img src={p.about.photo} alt="" width="96" height="96">
      <span><b>{p.about.sign}</b>{p.hero.by}</span>
    </p>
  </div>
</section>

<section class="sec svc" id={p.services.id}>
  <div class="wrap">
    <div class="head wide">
      <h2 set:html={rich(p.services.h2)} />
      <p class="intro">{p.services.intro}</p>
    </div>
    <div class="split">
      {p.services.groups.map((g) => (
        <div class="side">
          <h3 set:html={rich(g.h3)} />
          <p class="sub">{g.text}</p>
          <ul>
            {g.items.map((it) => (
              <li><a href={it.to} data-cta={cta(it.to)} class:list={{ live: !it.to.startsWith('#') }}>
                <span class="name">{it.name}{it.badge && <span class="badge">{it.badge}</span>}</span>
                <span class="text">{it.text}</span>
                <span class="go">{it.go}<Arrow /></span>
              </a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="sec industries" id={p.industries.id}>
  <div class="wrap">
    <div class="head wide"><h2 set:html={rich(p.industries.h2)} /></div>
    <ul class="rows">
      {p.industries.items.map((it) => (
        <li><a href={it.to} data-cta={cta(it.to)}>
          <span class="name">{it.name}{it.badge && <span class="badge">{it.badge}</span>}</span>
          <span class="text">{it.text}</span>
          <span class="go">{it.go}<Arrow /></span>
        </a></li>
      ))}
    </ul>
  </div>
</section>

<Steps id={p.build.id} h2={p.build.h2} intro={p.build.intro} items={p.build.stages}>
  <Gantt week={p.build.week} weeks={p.build.weeks} ongoing={p.build.ongoing} stages={p.build.stages} />
  <a class="btn" href={p.build.cta_to} data-cta={cta(p.build.cta_to)}><span>{p.build.cta}</span><Arrow /></a>
</Steps>

<section class="sec proof">
  <div class="wrap">
    <div class="head wide">
      <h2 set:html={rich(p.proof.h2)} />
      <p class="intro">{p.proof.intro}</p>
    </div>
    <div class="figs">
      {p.proof.items.map((f) => (
        <div><b class="fig">{f.fig}</b><p class="lbl">{f.label}</p><p>{f.text}</p></div>
      ))}
    </div>
    <a class="btn" href={p.proof.cta_to} data-cta={cta(p.proof.cta_to)}><span>{p.proof.cta}</span><Arrow /></a>
  </div>
</section>

<section class="sec faq" id="faq">
  <div class="wrap grid">
    <div class="head sticky"><h2 set:html={rich(p.faq.h2)} /></div>
    <div class="qa">
      {p.faq.items.map((x) => (
        <div><h3>{x.q}</h3><p>{x.a}</p></div>
      ))}
    </div>
  </div>
</section>

<section class="sec about" id="about">
  <div class="wrap grid">
    <img class="photo" src={p.about.photo} alt={site.name} width="640" height="640" loading="lazy">
    <div class="head">
      <h2 set:html={rich(p.about.h2)} />
      {p.about.paras.map((x) => <p class="para">{x}</p>)}
      <p class="sign">{p.about.sign}</p>
      {p.about.cta && <a class="btn" href="#apply" data-cta><span>{p.about.cta}</span><Arrow /></a>}
    </div>
  </div>
</section>

<section class="sec ask">
  <div class="wrap grid">
    <div class="head">
      <h2 set:html={rich(p.close.h2)} />
      <p class="intro">{p.close.text}</p>
    </div>
    <Apply a={p.ask} offer={offer} email={site.email} path={p.path} />
  </div>
</section>
</main>

<End site={site} />

<script src="../scripts/pitch.ts"></script>
<script src="../scripts/hit.ts"></script>
<Analytics />
</body>
</html>
