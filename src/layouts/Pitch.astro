---
// A page that sells one offer: / and /recruiting. Copy from src/content/pitches, terms from the offer
// (src/data/offers.json via lib/pitch.ts). The first screen holds who it's for, the pain, what Wren does and
// the form. Sections below render in this order; an optional one left out of the yaml doesn't render.
// Reads fully with JS off; src/scripts/pitch.ts adds the scroll motion and the one-question-at-a-time form.
import '../styles/pitch.css';
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';
import Head from '../components/Head.astro';
import Analytics from '../components/Analytics.astro';
import Mark from '../components/Mark.astro';
import Arrow from '../components/pitch/Arrow.astro';
import Calc from '../components/pitch/Calc.astro';
import Apply from '../components/pitch/Apply.astro';
import { loadPitch } from '../lib/pitch';
import { bare, rich, richParas } from '../lib/text';

const { entry } = Astro.props as { entry: CollectionEntry<'pitches'> };
const { p, offer, next } = await loadPitch(entry);
const site = (await getEntry('site', 'site'))!.data;
const turnstile = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const year = new Date().getFullYear();
const FONTS = 'https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400..700&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&display=swap';
---
<!doctype html>
<html lang="en" class="pitch" data-niche={p.form_value}>
<head>
  <Head title={bare(p.title)} description={bare(p.description)} fonts={FONTS} theme="#FAF9F6" />
  <meta name="color-scheme" content="light">
  <script is:inline>
    /* motion on: the scroll-drawn parts start undrawn. Off for ?static and reduced motion, so the page reads as-is. */
    try{if(!new URLSearchParams(location.search).has('static')&&!matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('js')}catch(e){}
  </script>
</head>
<body>

<header class="top" data-nav>
  <div class="wrap bar">
    <a class="home" href="#top" aria-label="Wren Automation, top of page"><Mark /></a>
    <nav class="links" aria-label="Page">{p.nav.map((n) => <a href={n.to}>{n.label}</a>)}</nav>
    <a class="btn ink sm" href="#apply" data-cta><span>{p.nav_cta}</span><Arrow /></a>
  </div>
</header>

<main>
<section class="hero" id="top">
  <div class="wrap hero-grid">
    <div class="copy">
      <h1 set:html={rich(p.hero.h1)} />
      <div class="lede" set:html={richParas(p.hero.lede)} />
      <a class="more" href={p.hero.second_to}>{p.hero.second}<Arrow /></a>
    </div>
    <Apply a={p.ask} offer={offer} email={site.email} path={p.path} />
    {p.hero.facts && (
      <dl class="facts">{p.hero.facts.map((f) => <div><dt>{f.k}</dt><dd>{f.v}</dd></div>)}</dl>
    )}
    <p class="by">
      <img src={p.about.photo} alt="" width="96" height="96">
      <span><b>{p.about.sign}</b>{p.hero.by}</span>
    </p>
  </div>
</section>

{p.strip && (
  <section class="strip" aria-label={p.strip.label}>
    <div class="wrap"><p>{p.strip.label}</p><ul>{p.strip.items.map((x) => <li>{x}</li>)}</ul></div>
  </section>
)}

{p.field && (
  <section class="sec field" id="field">
    <div class="wrap grid">
      <div class="head">
        <h2 set:html={rich(p.field.h2)} />
        <div class="intro" set:html={richParas(p.field.text)} />
        <ul class="legend">
          <li><i class="dim"></i>{p.field.dormant}</li>
          <li><i class="lit"></i>{p.field.awake}</li>
        </ul>
      </div>
      <div class="dots"><canvas data-field aria-hidden="true"></canvas></div>
    </div>
  </section>
)}

{p.calc && <Calc c={p.calc} />}

<section class="sec halves" id="halves">
  <div class="wrap">
    <div class="head wide">
      <h2 set:html={rich(p.halves.h2)} />
      <p class="intro">{p.halves.intro}</p>
    </div>
    <div class="split">
      {p.halves.sides.map((s) => (
        <article class="side">
          <h3 set:html={rich(s.h3)} />
          <p class="sub"><b>{s.tag}.</b> {s.text}</p>
          <ul>
            {s.items.map((it) => (
              <li><b>{it.name}</b>{it.badge && <span class="badge">{it.badge}</span>}<p>{it.text}</p></li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <p class="bridge" set:html={rich(p.halves.bridge)} />
  </div>
</section>

{p.industries && (
  <section class="sec industries" id="industries">
    <div class="wrap">
      <div class="head wide"><h2 set:html={rich(p.industries.h2)} /></div>
      <ul class="rows">
        {p.industries.items.map((it) => (
          <li><a href={it.to} data-cta={it.to === '#apply' ? '' : undefined}>
            <span class="name">{it.name}{it.badge && <span class="badge">{it.badge}</span>}</span>
            <span class="text">{it.text}</span>
            <span class="go">{it.go}<Arrow /></span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>
)}

<section class="sec steps" id="how">
  <div class="wrap grid">
    <div class="head sticky">
      <h2 set:html={rich(p.steps.h2)} />
      <p class="intro">{p.steps.intro}</p>
    </div>
    <ol class="timeline" data-timeline>
      <span class="rail" aria-hidden="true"><i data-rail></i></span>
      {p.steps.items.map((s) => (
        <li data-stop><span class="node" aria-hidden="true"></span><h3>{s.name} <span class="when">{s.when}</span></h3><p>{s.text}</p></li>
      ))}
    </ol>
  </div>
</section>

{p.deal && (
  <section class="sec deal" id="deal">
    <div class="wrap">
      <div class="head wide">
        <h2 set:html={rich(p.deal.h2)} />
        <p class="intro">{offer.promise}</p>
      </div>
      <div class="terms">
        {[
          { h: p.deal.get, items: offer.youGet },
          { h: p.deal.give, items: offer.youGive },
          { h: p.deal.we_get, items: offer.weGet },
        ].map((t) => (
          <div><h3>{t.h}</h3><ul>{t.items.map((x) => <li>{x}</li>)}</ul></div>
        ))}
      </div>
      {offer.guarantee && (
        <div class="guarantee"><span>{p.deal.guarantee}</span><p>{offer.guarantee}</p></div>
      )}
      <div class="why">
        {p.deal.why.map((w) => <div><h3>{w.q}</h3><p>{w.a}</p></div>)}
      </div>
    </div>
  </section>
)}

{p.ladder && next.length > 0 && (
  <section class="sec ladder">
    <div class="wrap grid">
      <div class="head">
        <h2 set:html={rich(p.ladder.h2)} />
        <p class="intro">{p.ladder.intro}</p>
      </div>
      <ol class="rungs">
        <li class="now"><h3>{offer.name}</h3><p class="tag">{p.ladder.now}</p><p>{offer.promise}</p></li>
        {next.map((o) => (
          <li><h3>{o.name}</h3><p class="tag">{p.ladder!.names[o.id]}</p><p>{o.promise}</p></li>
        ))}
      </ol>
    </div>
  </section>
)}

<section class="sec proof">
  <div class="wrap">
    <div class="head wide">
      <h2 set:html={rich(p.proof.h2)} />
      <p class="intro">{p.proof.intro}</p>
    </div>
    <div class="figs">
      {p.proof.items.map((f) => (
        <div><b class="fig">{f.fig}</b><p class="lbl">{f.label}</p><p>{f.text}</p></div>
      ))}
    </div>
  </div>
</section>

<section class="sec about" id="about">
  <div class="wrap grid">
    <img class="photo" src={p.about.photo} alt={site.name} width="640" height="640" loading="lazy">
    <div class="head">
      <h2 set:html={rich(p.about.h2)} />
      {p.about.paras.map((x) => <p class="para">{x}</p>)}
      <p class="sign">{p.about.sign}</p>
    </div>
  </div>
</section>

<section class="sec faq">
  <div class="wrap grid">
    <div class="head sticky"><h2 set:html={rich(p.faq.h2)} /></div>
    <div class="qa">
      {p.faq.items.map((x) => (
        <details><summary>{x.q}<i aria-hidden="true"></i></summary><p>{x.a}</p></details>
      ))}
    </div>
  </div>
</section>

<section class="close">
  <div class="wrap">
    <h2 set:html={rich(p.close.h2)} />
    <p>{p.close.text}</p>
    <a class="btn" href="#apply" data-cta><span>{p.close.cta}</span><Arrow /></a>
  </div>
</section>
</main>

<footer class="foot">
  <div class="wrap">
    <a class="home" href="#top" aria-label="Wren Automation, top of page"><Mark /></a>
    <a href={`mailto:${site.email}`}>{site.email}</a>
    <p class="fine">© {year} Wren Automation · {site.city} · {site.fine}{turnstile && <> {site.fine_turnstile} <a href="https://www.cloudflare.com/turnstile-privacy-policy/">{site.fine_turnstile_link}</a>.</>} <a href="/privacy">{site.fine_privacy}</a></p>
  </div>
</footer>

<a class="btn float" href="#apply" data-cta data-float><span>{p.nav_cta}</span><Arrow /></a>

<script src="../scripts/pitch.ts"></script>
<script src="../scripts/hit.ts"></script>
<Analytics />
</body>
</html>
