---
// A page that sells one offer: /recruiting/lead-reactivation (the hub, /, is Hub.astro). Copy from src/content/pitches, terms from the offer
// (src/data/offers.json via lib/pitch.ts). The first screen holds who it's for, the pain, what Wren does and
// the form. Sections below render in this order; an optional one left out of the yaml doesn't render.
// Reads fully with JS off; src/scripts/pitch.ts adds the scroll motion and the one-question-at-a-time form.
import '../styles/pitch.css';
import '../styles/cursor.css';
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';
import Head from '../components/Head.astro';
import Photo from '../components/Photo.astro';
import Analytics from '../components/Analytics.astro';
import Consent from '../components/Consent.astro';
import Arrow from '../components/pitch/Arrow.astro';
import Fig from '../components/pitch/Fig.astro';
import Scene from '../components/pitch/Scene.astro';
import Problem from '../components/pitch/Problem.astro';
import Benefits from '../components/pitch/Benefits.astro';
import Shot from '../components/pitch/Shot.astro';
import Steps from '../components/pitch/Steps.astro';
import Start from '../components/pitch/Start.astro';
import Gantt from '../components/pitch/Gantt.astro';
import Apply from '../components/pitch/Apply.astro';
import Top from '../components/pitch/Top.astro';
import Loader from '../components/pitch/Loader.astro';
import Backdrop from '../components/pitch/Backdrop.astro';
import End from '../components/pitch/End.astro';
import { loadPitch } from '../lib/pitch';
import { bare, rich, richParas } from '../lib/text';

const { entry } = Astro.props as { entry: CollectionEntry<'pitches'> };
const { p, offer } = await loadPitch(entry);
const site = (await getEntry('site', 'site'))!.data;
---
<!doctype html>
<html lang="en" class="pitch" data-niche={p.form_value}>
<head>
  <Head title={bare(p.title)} description={bare(p.description)} theme="#ffffff" faq={p.faq.items} services={[{ name: offer.name, text: p.description }]} />
  <meta name="color-scheme" content="light">
  <script is:inline>
    /* motion on: the scroll-drawn parts start undrawn. Off for ?static, reduced motion, data saver, a 2g/3g link and
       low-end devices (2 cores or 2GB), so the page reads as-is and nothing waits on an animation. */
    /* ?prompts prints each empty image slot's prompt on the tile. */
    try{var q=new URLSearchParams(location.search),h=document.documentElement;if(q.has('prompts'))h.classList.add('prompts');var c=navigator.connection,lite=c&&(c.saveData||/(^|-)[23]g$/.test(c.effectiveType||''))||(navigator.hardwareConcurrency||8)<=2||(navigator.deviceMemory||8)<=2;if(!lite&&!q.has('static')&&!matchMedia('(prefers-reduced-motion: reduce)').matches)h.classList.add('js')}catch(e){}
  </script>
</head>
<body>
<Fragment set:html="<!--email_off-->" />{/* Cloudflare leaves the addresses alone: no render-blocking email-decode script */}
<Loader />
<Backdrop />

<Top nav={p.nav} cta={p.nav_cta} />

<main>
<section class="hero" id="top">
  <div class="wrap hero-grid">
    <div class="copy">
      {p.hero.proof && <p class="kicker"><i></i>{p.hero.proof}</p>}
      <h1 class:list={{ long: p.hero.h1.length > 60 }}><Fragment set:html={rich(p.hero.h1)} />{p.hero.h1_tail && <span class="tail"> {p.hero.h1_tail}{p.hero.h1_note && <span class="note"> {p.hero.h1_note}</span>}</span>}</h1>
      <div class="lede" set:html={richParas(p.hero.lede)} />
      {p.hero.promise && (
        <div class="promise"><p class="label">{p.hero.promise.h}</p><ul>{p.hero.promise.items.map((x) => <li set:html={rich(x)} />)}</ul></div>
      )}
      {p.hero.second
        ? <a class="more" href={p.hero.second_to}>{p.hero.second}<Arrow /></a>
        : <a class="more down" href={p.hero.second_to} aria-label="Read on"><svg viewBox="0 0 24 40" aria-hidden="true"><path d="M12 2v34M3 27l9 9 9-9" /></svg></a>}
    </div>
    <Apply a={p.ask} offer={offer} email={site.email} path={p.path} />
    {p.hero.scene && <Scene s={p.hero.scene} />}
    <p class="by">
      <img src="/face.jpg" alt="" width="96" height="96">
      <span><b>{p.about.sign}</b>{p.hero.by}</span>
    </p>
  </div>
</section>

{p.problem && <Problem s={p.problem} />}

{p.benefits && <Benefits s={p.benefits} />}

{p.halves && (
<section class="sec halves" id="halves">
  <div class="wrap">
    <div class="head wide">
      <h2 set:html={rich(p.halves.h2)} />
      <p class="intro">{p.halves.intro}</p>
    </div>
    <div class="split">
      {p.halves.sides.map((s) => (
        <article class="side">
          {s.image && <Shot s={s.image} />}
          <h3 set:html={rich(s.h3)} />
          <p class="sub"><b>{s.tag}.</b> {s.text}</p>
          <ul>
            {s.items.map((it) => (
              <li><b>{it.name}</b>{it.badge && <span class="badge">{it.badge}</span>}<p>{it.text}</p></li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <p class="bridge" set:html={rich(p.halves.bridge)} />
  </div>
</section>
)}

{p.industries && (
  <section class="sec industries" id="industries">
    <div class="wrap">
      <div class="head wide"><h2 set:html={rich(p.industries.h2)} /></div>
      <ul class="rows">
        {p.industries.items.map((it) => (
          <li><a href={it.to} data-cta={it.to === '#apply' ? '' : undefined}>
            <span class="name">{it.name}{it.badge && <span class="badge">{it.badge}</span>}</span>
            <span class="text">{it.text}</span>
            <span class="go">{it.go}<Arrow /></span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>
)}

{p.build && (
  <Steps id={p.build.id} h2={p.build.h2} intro={p.build.intro} items={p.build.stages}>
    <Gantt week={p.build.week} weeks={p.build.weeks} ongoing={p.build.ongoing} stages={p.build.stages} />
  </Steps>
)}

{p.proof && (
<section class="sec proof">
  <div class="wrap">
    <div class="head wide">
      <h2 set:html={rich(p.proof.h2)} />
      <p class="intro">{p.proof.intro}</p>
    </div>
    <div class="figs">
      {p.proof.items.map((f) => (
        <div><Fig v={f.fig} /><p class="lbl">{f.label}</p><p>{f.text}</p></div>
      ))}
    </div>
  </div>
</section>
)}

{p.start && <Start s={p.start} />}

<section class="sec faq" id="faq">
  <div class="wrap grid">
    <div class="head sticky"><h2 set:html={rich(p.faq.h2)} /></div>
    <div class="qa">
      {p.faq.items.map((x) => (
        <div><h3>{x.q}</h3><p>{x.a}</p></div>
      ))}
    </div>
  </div>
</section>

<section class="sec about" id="about">
  <div class="wrap grid">
    <Photo class="photo" src={p.about.photo} alt={site.name} width={560} height={746} sizes="(min-width: 900px) 440px, 320px" />
    <div class="head">
      <h2 set:html={rich(p.about.h2)} />
      {p.about.paras.map((x) => <p class="para" set:html={rich(x)} />)}
      {p.about.ideal && <div class="ideal"><p>{p.about.ideal.h}</p><ul>{p.about.ideal.items.map((t) => <li>{t}</li>)}</ul></div>}
      <div class="signoff">
        <p class="sign">{p.about.sign}</p>
        {p.about.cta && <a class="btn" href="#apply" data-cta><span>{p.about.cta}</span><Arrow /></a>}
      </div>
    </div>
  </div>
</section>

<section class="close">
  <Backdrop dark="close" />
  <div class="wrap grid">
    <div class="head">
      <h2 set:html={rich(p.close.h2)} />
      {p.close.reason && <p class="reason" set:html={rich(p.close.reason)} />}
      <p>{p.close.text}</p>
    </div>
    {p.close.vs && (
      <div class="vs">
        <p class="hd win">{p.close.vs.win}</p><p class="hd lose">{p.close.vs.lose}</p>
        {p.close.vs.rows.map(([w, l]) => <><p class="win">{w}</p><p class="lose">{l}</p></>)}
      </div>
    )}
    <a class="btn" href="#apply" data-cta><span>{p.close.cta}</span><Arrow /></a>
  </div>
</section>

{p.sources && (
<section class="sources" id="sources">
  <div class="wrap">
    <h2>{p.sources.h}</h2>
    <ol>{p.sources.items.map((x, i) => <li id={`source-${i + 1}`}><a href={x.url} target="_blank" rel="noopener">{x.text}</a></li>)}</ol>
  </div>
</section>
)}
</main>

<End site={site} />


<script src="../scripts/pitch.ts"></script>
<Consent />
<script src="../scripts/hit.ts"></script>
<Analytics />
<Fragment set:html="<!--/email_off-->" />
</body>
</html>
