---
// The whole page. Copy comes from src/content; nothing here is prose.
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';
import Base from './Base.astro';
import Band from '../components/Band.astro';
import Mark from '../components/Mark.astro';
import Trace from '../components/Trace.astro';
import Foot from '../components/Foot.astro';
import { inline, plain } from '../lib/text';

const { niche } = Astro.props as { niche: CollectionEntry<'niches'> };
const n = niche.data;
const site = (await getEntry('site', 'site'))!.data;
const cases = (await Promise.all(n.cases.map((id) => getEntry('cases', id)))).map((c, i) => {
  if (!c) throw new Error(`niches/${niche.id}.yaml lists a case study that does not exist: ${n.cases[i]}`);
  return c.data;
});
const turnstile = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
// Input attributes follow from the column, not the copy file.
const input = { name: { type: 'text', autocomplete: 'given-name' }, email: { type: 'email', autocomplete: 'email' }, phone: { type: 'tel', autocomplete: 'tel' }, note: {}, questions: {} } as const;
const multi = new Set(['note', 'questions']);
---
<Base title={n.title} description={plain(n.lede)} hue={n.hue}>

<div class="wrap">
  <nav class="nav" aria-label="Page">
    <a href="#top" aria-label="Wren Automation, top of page"><Mark /></a>
    <div class="right">
      <div class="links"><a href="#work">{site.nav.work}</a><a href="#offer">{site.nav.offer}</a><a href="#about">{site.nav.about}</a><a href="#ask">{site.nav.contact}</a></div>
      <a class="contact" href="#ask">{site.nav.contact}</a>
      <button class="theme" type="button" data-theme-toggle data-to-dark={site.theme.to_dark} data-to-light={site.theme.to_light} aria-label="Switch between light and dark">{site.theme.to_dark}</button>
    </div>
  </nav>
</div>

<section class="hero" id="top">
  <div class="wrap" data-intro-target>
    <p class="kicker">{n.kicker}</p>
    <h1>{n.h1}</h1>
    <p class="lede" set:html={inline(n.lede)} />
    <a class="btn" href="#ask">{site.cta}</a>
  </div>
</section>

<div class="wrap">
  <aside class="teaser" aria-label={site.offer.eyebrow}>
    <h4>{site.offer.eyebrow}</h4>
    <p class="promise" set:html={inline(site.offer.promise)} />
    <p class="safe">{site.offer.safe}</p>
    <a href="#offer">{site.offer.more} &rarr;</a>
  </aside>
</div>

<Band seed={3} />

<section class="s" id="sides">
  <div class="wrap">
    <h2>{n.sides_h2}</h2>
    <p class="intro">{n.sides_intro}</p>
    <div class="sides" role="table">
      <div class="hd" role="row"><span role="columnheader">{n.sides_hand}</span><span role="columnheader">{n.sides_auto}</span></div>
      {n.sides.map((r) => <div role="row"><span role="cell">{r.hand}</span><span role="cell" class="auto">{r.auto}</span></div>)}
    </div>
  </div>
</section>

<section class="s" id="work">
  <div class="wrap">
    <h2>{site.work_h2}</h2>
    <p class="intro">{site.work_intro}</p>
    {cases.map((c) => (
      <article class="case">
        <div class="head"><h3>{c.result}</h3><span>{c.client} · {c.kind}</span></div>
        <div class="impact">
          {c.impact.map((m) => (
            <div><div class="fig" data-count={m.count} data-suffix={m.suffix}>{m.fig}</div><div class="lbl">{m.label}</div></div>
          ))}
        </div>
        <div class="top">
          <div><h4>{site.case_labels.story}</h4><p>{c.story}</p></div>
          <div><h4>{site.case_labels.now}</h4><p>{c.now}</p></div>
        </div>
        <div class="pipe">
          <h4>{site.case_labels.built}</h4>
          <div class="lead">
            <p>{c.pipe_lead}</p>
            <div class="legend"><span><i class="f"></i>{site.case_labels.person}</span><span><i></i>{site.case_labels.auto}</span></div>
          </div>
          <ol>
            {c.steps.map((s) => (
              <li class:list={{ you: s.you }}><i class="dot"></i><b>{s.name}</b><p>{s.text}</p></li>
            ))}
          </ol>
        </div>
        <div class="foot">{c.stack}</div>
      </article>
    ))}
    <a class="more" href="#ask">{site.mid_cta} &rarr;</a>
  </div>
</section>

<Band seed={7} />

<section class="s" id="proves">
  <div class="wrap">
    <h2>{n.proves_h2}</h2>
    <p class="intro">{n.proves_intro}</p>
    <div class="rows">
      {n.proves.map((r) => <div><b>{r.point}</b><span>{r.detail}</span></div>)}
    </div>
  </div>
</section>

<section class="s" id="targets">
  <div class="wrap">
    <h2>{n.targets_h2}</h2>
    <p class="intro">{n.targets_intro}</p>
    <div class="rows">
      {n.targets.map((t) => <div><b>{t.what}</b><span>{t.how}</span></div>)}
    </div>
  </div>
</section>

<Band seed={11} />

<section class="s" id="offer">
  <div class="wrap steps">
    <h2>{site.offer_h2}</h2>
    <p class="intro">{site.offer_intro}</p>
    <svg viewBox="0 0 1120 70" aria-hidden="true" data-steps>
      <path d="M8 35 H180 L195 20 H240 L255 35 H394"/>
      <path d="M394 35 H560 L575 50 H620 L635 35 H781"/>
      <path d="M781 35 H960 L975 20 H1040"/>
      <path d="M300 35 L315 50 H360"/>
      <path d="M880 35 L895 50 H940"/>
      <circle cx="1044" cy="20" r="4"/>
      <circle cx="364" cy="50" r="4"/>
      <circle cx="944" cy="50" r="4"/>
      <circle class="big" cx="8" cy="35" r="7"/>
      <circle class="big" cx="394" cy="35" r="7"/>
      <circle class="big" cx="781" cy="35" r="7"/>
    </svg>
    <div class="cols">
      {site.how.map((h, i) => (
        <div><div class="n">{String(i + 1).padStart(2, '0')}</div><h3>{h.name}</h3><p>{h.text}</p></div>
      ))}
    </div>
    <div class="principles">
      <h3>{site.principles_h3}</h3>
      <div class="cols">
        {site.principles.map((p, i) => (
          <div>
            <Trace i={i} />
            <h3>{p.name}</h3><p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
    <a class="more" href="#ask">{site.mid_cta} &rarr;</a>
  </div>
</section>

<Band seed={13} />

<section class="s" id="alt">
  <div class="wrap">
    <h2>{site.alt_h2}</h2>
    <p class="intro">{site.alt_intro}</p>
    <div class="rows three">
      {site.alt.map((a) => <div><b>{a.who}</b><span>{a.text}</span></div>)}
    </div>
  </div>
</section>

<section class="s" id="questions">
  <div class="wrap">
    <h2>{site.questions_h2}</h2>
    <p class="intro">{site.questions_intro}</p>
    <div class="qa">
      {site.questions.map((x) => <div><h3>{x.q}</h3><p>{x.a}</p></div>)}
    </div>
  </div>
</section>

<Band seed={5} />

<section class="s" id="about">
  <div class="wrap about">
    <div class:list={["photo", { empty: !site.photo }]}>{site.photo && <img src={site.photo} alt={site.name} loading="lazy">}</div>
    <div>
    <h2>{site.about_h2}</h2>
      {site.about.map((p, i) => <p style={i === 0 ? 'margin-top:.6rem' : undefined}>{p}</p>)}
      <h3>{site.why_h3}</h3>
      {site.why.map((p) => <p>{p}</p>)}
    </div>
  </div>
</section>

<section class="s ask" id="ask">
  <div class="wrap grid">
    <div>
      <p class="pre">{site.ask_pre}</p>
      <h2>{site.cta}</h2>
      <p set:html={inline(site.ask_intro)} />
    </div>
    <div data-ask>
      <form method="post" action="/api/lead" data-lead>
        {site.ask_fields.map((f) => (
          <div class="field">
            <label for={`f-${f.key}`}>{f.label}{f.required && <span class="req" aria-hidden="true"> *</span>}</label>
            {multi.has(f.key)
              ? <textarea id={`f-${f.key}`} name={f.key} placeholder={f.placeholder} required={f.required} aria-describedby={f.error ? `e-${f.key}` : undefined} class:list={{ short: f.key === 'questions' }}></textarea>
              : <input id={`f-${f.key}`} name={f.key} placeholder={f.placeholder} required={f.required} aria-describedby={f.error ? `e-${f.key}` : undefined} {...input[f.key]}>}
            {f.error && <p class="fe" id={`e-${f.key}`} data-error>{f.error}</p>}
          </div>
        ))}
        <input type="hidden" name="niche" value={n.form_value}>
        <input type="hidden" name="page" value={Astro.url.pathname}>
        {['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'ref'].map((k) => <input type="hidden" name={k} value="">)}
        <label class="hp" aria-hidden="true" tabindex="-1">Leave empty<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
        {turnstile && <div class="cf-turnstile" data-sitekey={turnstile} data-size="flexible"></div>}
        <button class="btn" type="submit">{site.ask_submit}</button>
        <small>{site.ask_required}</small>
        <p class="err" role="alert">{site.ask_error} <a href={`mailto:${site.email}`}>{site.email}</a></p>
      </form>
      <div class="sent" role="status"><h3>{site.thanks_h}</h3><p>{site.thanks}</p></div>
    </div>
  </div>
</section>

<Foot site={site} />

{turnstile && <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>}
</Base>
