---
// The whole page. Copy comes from src/content; nothing here is prose.
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';
import Base from './Base.astro';
import Band from '../components/Band.astro';
import Mark from '../components/Mark.astro';
import { inline, plain } from '../lib/text';

const { niche } = Astro.props as { niche: CollectionEntry<'niches'> };
const n = niche.data;
const site = (await getEntry('site', 'site'))!.data;
const cases = (await Promise.all(n.cases.map((id) => getEntry('cases', id)))).map((c, i) => {
  if (!c) throw new Error(`niches/${niche.id}.yaml lists a case study that does not exist: ${n.cases[i]}`);
  return c.data;
});
const turnstile = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---
<Base title={n.title} description={plain(n.lede)} hue={n.hue}>

<div class="wrap">
  <nav class="nav" aria-label="Page">
    <a href="#top" aria-label="Wren Automation, top of page"><Mark /></a>
    <div class="right">
      <div class="links"><a href="#work">Work</a><a href="#how">How it works</a><a href="#about">About</a><a href="#ask">Contact</a></div>
      <a class="contact" href="#ask">Contact</a>
      <button class="theme" type="button" data-theme-toggle aria-label="Switch between light and dark">Dark</button>
    </div>
  </nav>
</div>

<section class="hero" id="top">
  <div class="wrap">
    <h1>{n.h1}</h1>
    <p class="lede" set:html={inline(n.lede)} />
    <a class="btn" href="#ask">{site.cta}</a>
    <p class="from">{site.from_note}</p>
  </div>
</section>

<div class="wrap">
  <div class="proof">
    {site.proof.map((p) => (
      <div><div class="fig" data-count={p.count} data-suffix={p.suffix}>{p.fig}</div><div class="lbl">{p.label}</div></div>
    ))}
  </div>
</div>

<Band seed={3} />

<section class="s" id="work">
  <div class="wrap">
    <h2>Work</h2>
    <p class="intro">{site.work_intro}</p>
    {cases.map((c) => (
      <article class="case">
        <div class="head"><h3>{c.client}</h3><span>{c.kind}</span></div>
        <div class="top">
          <div><h4>Before</h4><p>{c.before}</p></div>
          <div><h4>Day to day now</h4><p>{c.now}</p></div>
        </div>
        <div class="pipe">
          <div class="lead">
            <p>{c.pipe_lead}</p>
            <div class="legend"><span><i class="f"></i>a person does this</span><span><i></i>runs on its own</span></div>
          </div>
          <ol>
            {c.steps.map((s) => (
              <li class:list={{ you: s.you }}><i class="dot"></i><b>{s.name}</b><p>{s.text}</p></li>
            ))}
          </ol>
        </div>
        <div class="impact">
          {c.impact.map((m) => (
            <div><div class="fig" data-count={m.count} data-suffix={m.suffix}>{m.fig}</div><div class="lbl">{m.label}</div></div>
          ))}
        </div>
        <div class="foot">{c.stack}</div>
      </article>
    ))}
  </div>
</section>

<section class="s" id="targets" style="padding-top:0">
  <div class="wrap">
    <h2>{n.targets_h2}</h2>
    <p class="intro">{n.targets_intro}</p>
    <div class="targets">
      {n.targets.map((t) => <div><b>{t.what}</b><span>{t.how}</span></div>)}
    </div>
  </div>
</section>

<section class="s" id="how" style="padding-top:0">
  <div class="wrap steps">
    <h2>How it works</h2>
    <p class="intro">{site.how_intro}</p>
    <svg viewBox="0 0 1120 70" aria-hidden="true" data-steps>
      <path d="M8 35 H180 L195 20 H240 L255 35 H394"/>
      <path d="M394 35 H560 L575 50 H620 L635 35 H781"/>
      <path d="M781 35 H960 L975 20 H1040"/>
      <path d="M300 35 L315 50 H360"/>
      <path d="M880 35 L895 50 H940"/>
      <circle cx="1044" cy="20" r="4"/>
      <circle cx="364" cy="50" r="4"/>
      <circle cx="944" cy="50" r="4"/>
      <circle class="big" cx="8" cy="35" r="7"/>
      <circle class="big" cx="394" cy="35" r="7"/>
      <circle class="big" cx="781" cy="35" r="7"/>
    </svg>
    <div class="cols">
      {site.how.map((h, i) => (
        <div><div class="n">{String(i + 1).padStart(2, '0')}</div><h3>{h.name}</h3><p>{h.text}</p></div>
      ))}
    </div>
  </div>
</section>

<section class="s" id="questions" style="padding-top:0">
  <div class="wrap">
    <h2>Questions you probably have</h2>
    <p class="intro">{site.questions_intro}</p>
    <div class="qa">
      {site.questions.map((x) => <div><h3>{x.q}</h3><p>{x.a}</p></div>)}
    </div>
  </div>
</section>

<Band seed={5} />

<section class="s" id="about">
  <div class="wrap about">
    <div class="photo">{site.photo ? <img src={site.photo} alt={site.name} loading="lazy"> : 'photo'}</div>
    <div>
      <h2>About</h2>
      {site.about.map((p, i) => <p style={i === 0 ? 'margin-top:.6rem' : undefined}>{p}</p>)}
      <div class="facts">
        {site.facts.map((f) => <div>{f.fact}<span>{f.note}</span></div>)}
      </div>
    </div>
  </div>
</section>

<section class="s ask" id="ask">
  <div class="wrap grid">
    <div>
      <h2>{site.cta}</h2>
      <p set:html={inline(site.ask_intro)} />
    </div>
    <div data-ask>
      <form method="post" action="/api/lead" data-lead>
        <label>{site.ask_fields.email}<input type="email" name="email" autocomplete="email" placeholder="you@firm.com" required></label>
        <label>{site.ask_fields.phone} <span>(optional)</span><input type="tel" name="phone" autocomplete="tel" placeholder="+1"></label>
        <label>{site.ask_fields.note}<textarea name="note" placeholder={site.ask_fields.note_placeholder}></textarea></label>
        <input type="hidden" name="niche" value={n.form_value}>
        <input type="hidden" name="page" value={Astro.url.pathname}>
        <label class="hp" aria-hidden="true" tabindex="-1">Leave empty<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
        {turnstile && <div class="cf-turnstile" data-sitekey={turnstile} data-size="flexible"></div>}
        <button class="btn" type="submit">Send</button>
        <small>{site.ask_small}</small>
        <p class="err">That didn't send. Email me instead: <a href={`mailto:${site.email}`}>{site.email}</a></p>
      </form>
      <div class="sent" role="status"><h3>{site.thanks_h}</h3><p>{site.thanks}</p></div>
    </div>
  </div>
</section>

<div class="wrap">
  <footer>
    <div><Mark /></div>
    <div>{site.footer_line} <a href={`mailto:${site.email}`}>{site.email}</a></div>
    <div class="fine">Wren Automation · {site.city} · {site.fine}</div>
  </footer>
</div>

{turnstile && <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>}
</Base>
