---
// Footer for every page. Copy is in site.yaml.
import Mark from './Mark.astro';
const { site } = Astro.props;
const year = new Date().getFullYear();
---
<div class="wrap">
  <footer>
    <div><Mark /></div>
    <div>{site.footer_line} <a href={`mailto:${site.email}`}>{site.email}</a></div>
    <div class="fine">© {year} Wren Automation · {site.city} · {site.fine}</div>
  </footer>
</div>
