---
// Footer for every page. Copy is in site.yaml.
import Mark from './Mark.astro';
const { site } = Astro.props;
const turnstile = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY; // invisible mode requires naming Cloudflare's Turnstile Privacy Addendum
const year = new Date().getFullYear();
---
<div class="wrap">
  <footer>
    <div><Mark /></div>
    <div>{site.footer_line} <a href={`mailto:${site.email}`}>{site.email}</a></div>
    <div class="fine">© {year} Wren Automation · {site.city} · {site.fine}{turnstile && <> {site.fine_turnstile} <a href="https://www.cloudflare.com/turnstile-privacy-policy/">{site.fine_turnstile_link}</a>.</>}</div>
  </footer>
</div>
