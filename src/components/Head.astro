---
// Everything in <head> every page shares: meta, social cards, structured data, icons, fonts. Layouts add their own scripts after it.
import { getEntry } from 'astro:content';
import { structuredData, type QA, type Service } from '../lib/structured-data';
const { title, description, image = '/brand/wren-lockup.png', noindex = false, theme, faq, services } = Astro.props as {
  title: string; description: string; image?: string; noindex?: boolean;
  theme?: string; // a layout with one fixed theme colour
  faq?: QA[]; services?: Service[]; // the page's questions and what it sells, for the structured data
};
// build.format 'file' gives pathname "/x.html"; the served URL is "/x" (Pages redirects .html away)
const canonical = new URL(Astro.url.pathname.replace(/(?:\/?index)?\.html$/, ''), Astro.site);
const site = (await getEntry('site', 'site'))!.data;
// a noindex page (404) gets neither a canonical nor structured data: there is nothing there to point search at
const ld = !noindex && structuredData({ site, url: canonical, title, description, faq, services });
---
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={canonical}>}
<link rel="icon" href="/brand/wren-icon.png?v=lavender">
<link rel="apple-touch-icon" href="/brand/wren-icon.png?v=lavender">
{theme ? <meta name="theme-color" content={theme}> : <>
<meta name="theme-color" content="#faf7f2" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#110e0c" media="(prefers-color-scheme: dark)">
</>}
<meta property="og:type" content="website">
<meta property="og:site_name" content="Wren Automation">
<meta property="og:url" content={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={new URL(image, Astro.site)}>
<meta name="twitter:card" content="summary_large_image">
{ld && <script type="application/ld+json" set:html={ld} />}
{/* both faces are self-hosted (pitch.css, global.css): no third-party hop before the text can draw */}
<link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
