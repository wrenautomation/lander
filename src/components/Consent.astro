---
// The cookie banner. Hidden until /api/hit says this visitor must be asked (functions/_shared/consent.ts), or the
// "Cookie settings" button in a footer opens it. Not modal: the page stays usable while it's up.
import { getEntry } from 'astro:content';
const { cookies } = (await getEntry('site', 'site'))!.data;
---
<div class="cookie-banner" role="region" aria-label="Cookies" data-consent hidden>
  <p>{cookies.text} <a href="/privacy#cookies">{cookies.policy}</a></p>
  <div class="cookie-banner-do">
    <button type="button" data-choice="no">{cookies.no}</button>
    <button type="button" data-choice="yes">{cookies.yes}</button>
  </div>
</div>
<script src="../scripts/consent.ts"></script>
<style is:global>
  .cookie-banner{position:fixed;z-index:60;left:16px;right:16px;bottom:16px;max-width:560px;margin:0 auto;padding:16px 18px;display:flex;flex-wrap:wrap;gap:12px 16px;align-items:center;background:#0E0E0E;color:#FAF7F2;font:14px/1.5 Geist,'General Sans',system-ui,sans-serif;border:1px solid #2d2823;border-radius:2px}
  .cookie-banner[hidden]{display:none}
  .cookies-link{padding:0;background:none;border:0;color:inherit;font:inherit;text-decoration:underline;text-underline-offset:3px;cursor:pointer}
  .cookie-banner p{margin:0;flex:1 1 280px}
  .cookie-banner a{color:inherit;text-decoration:underline;text-underline-offset:3px}
  .cookie-banner-do{display:flex;gap:8px}
  .cookie-banner button{min-width:96px;min-height:44px;padding:0 16px;font-family:inherit;font-weight:600;font-size:14px;line-height:1;border-radius:2px;cursor:pointer;border:1px solid #FAF7F2;background:transparent;color:#FAF7F2}
  .cookie-banner button[data-choice=yes]{background:#FAF7F2;color:#0E0E0E}
  .cookie-banner button:focus-visible{outline:2px solid #FAF7F2;outline-offset:2px}
</style>
