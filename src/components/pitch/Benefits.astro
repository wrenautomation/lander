---
// The three benefits: one row each, the flow diagram on one side and the headline, a line and the button on the
// other, swapping sides row to row. The first and last rows carry a button. One line runs down the section from each diagram into the next (desktop).
import { rich } from '../../lib/text';
import Arrow from './Arrow.astro';
import Flow from './Flow.astro';
import HubFlow from './HubFlow.astro';
import FirmMap from './FirmMap.astro';
import type { CollectionEntry } from 'astro:content';

// recruiting: watch, reach, book (Flow). The hub: inbound, admin (HubFlow), then the firm map (FirmMap, drawn from s.map).
type Map = CollectionEntry<'hub'>['data']['benefits']['map'];
type Kind = 'watch' | 'reach' | 'book' | 'inbound' | 'admin' | 'map';
interface Props { s: { id: string; items: { flow: Kind; h2: string; text: string; cta?: string }[]; map?: Map } }
const { s } = Astro.props;
---
<section class="sec benefits" id={s.id}>
  <div class="wrap" data-flows>
    <svg class="joins" aria-hidden="true" data-joins></svg>
    {s.items.map((b, k) => (
      <div class:list={['bn', { flip: k % 2 }]}>
        {b.flow === 'map' ? <FirmMap m={s.map!} /> : b.flow === 'inbound' || b.flow === 'admin' ? <HubFlow kind={b.flow} /> : <Flow kind={b.flow} />}
        <div class="say">
          <h2 set:html={rich(b.h2)} />
          <p set:html={rich(b.text)} />
          {b.cta && <a class="btn" href="#apply" data-cta><span>{b.cta}</span><Arrow /></a>}
        </div>
      </div>
    ))}
  </div>
</section>
