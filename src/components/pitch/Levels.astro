---
// The five levels as building blocks: each level is a stack, one block taller than the last, its own block on top of
// the ones it stands on (the lower ones muted, the top one dark; the top level's green). Each block sits in a dashed
// outline of itself, seen while it's missing. Under the floor: the level's name, what now exists (checks) and what's
// still missing (crosses). Over each stack, a bubble with my face: what I build at that level. A dashed line marks
// where the data is ready for AI; a pin on the corner of its top block marks the level most companies jump in at.
// The button says how the call finds your level. On phones each stack lies flat, left to right.
// The markup is the finished state; pitch.ts (ART.levels) tells the story: the pinned level's block appears alone,
// shakes with nothing under it and falls, then the levels build in order, block on block.
import type { CollectionEntry } from 'astro:content';
import { rich } from '../../lib/text';
import { ICON } from '../../lib/icons';
import Arrow from './Arrow.astro';

const { s, face } = Astro.props as { s: CollectionEntry<'hub'>['data']['levels']; face: string };
---
<section class="sec levels" id={s.id}>
  <div class="wrap">
    <div class="head wide">
      <div><h2 set:html={rich(s.h2)} /><p class="intro" set:html={rich(s.text)} /></div>
      <div class="act"><a class="btn" href="#apply" data-cta><span>{s.cta}</span><Arrow /></a><p class="how">{s.how}</p></div>
    </div>
    <ol class="stairs" data-art="levels" data-start="top 60%">
      {s.items.map((x, i) => (
        <>
          {i === s.gate.after && <li class="gate"><b>{s.gate.name}</b></li>}
          <li class:list={{ most: i + 1 === s.most, peak: i === s.items.length - 1 }}>
            <div class="up">
              <p class="fix"><img src={face} alt="" width="24" height="24" loading="lazy">{x.fix}</p>
              <div class="riser" aria-hidden="true">
                {s.items.slice(0, i + 1).map((b, k) => (
                  <span class="spot"><i class:list={['brick', { own: k === i }]}><svg viewBox="0 0 16 16"><path d={ICON[b.icon]} /></svg><span>{b.brick}</span></i></span>
                ))}
                {i + 1 === s.most && <><em class="oops">{s.fall}</em><span class="pin">{s.most_note}</span></>}
              </div>
            </div>
            <div class="what">
              <p class="lv">{s.word} {i + 1}</p>
              <h3>{x.name}</h3>
              <ul class="pts">
                {x.has.map((t) => <li class="has">{t}</li>)}
                {x.lacks.map((t) => <li class="lacks">{t}</li>)}
              </ul>
            </div>
          </li>
        </>
      ))}
    </ol>
  </div>
</section>
