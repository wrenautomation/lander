---
// The five levels, as a staircase: each step a block one higher than the last, its name below, then what breaks
// without it (red cross), and a pin over the level most companies jump in at. Each step sits on a dashed outline of
// itself. The markup is the finished state; pitch.ts (ART.levels) tells the story: the pinned level goes up alone,
// shakes with nothing under it and falls, then the steps build in order.
import type { CollectionEntry } from 'astro:content';
import { rich } from '../../lib/text';
import Arrow from './Arrow.astro';

const { s } = Astro.props as { s: CollectionEntry<'hub'>['data']['levels'] };
---
<section class="sec levels" id={s.id}>
  <div class="wrap">
    <div class="head wide">
      <div><h2 set:html={rich(s.h2)} /><p class="intro" set:html={rich(s.text)} /></div>
      <a class="btn" href="#apply" data-cta><span>{s.cta}</span><Arrow /></a>
    </div>
    <ol class="stairs" data-art="levels">
      {s.items.map((x, i) => (
        <li class:list={{ most: i + 1 === s.most }} style={`--h:${i + 1}`}>
          <div class="rise">
            {i + 1 === s.most && <span class="pin">{s.most_note}</span>}
            <i class="block"><b>{s.word} {i + 1}</b>{i + 1 === s.most && <em class="oops" aria-hidden="true">{s.fall}</em>}</i>
          </div>
          <h3>{x.name}</h3>
          <p class="breaks">{x.breaks}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
