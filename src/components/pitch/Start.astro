---
// How a firm starts, as nodes on the flows' dotted canvas, joined left to right: a form, a video call, a file, then
// meetings on the calendar. Each card is a picture you read at a glance; the caption under it says the step.
// The names are made up. The words under the canvas carry the point (low risk).
import { rich } from '../../lib/text';
import Arrow from './Arrow.astro';
type Step = { name: string; time: string };
const { s } = Astro.props as { s: { id: string; h2: string; steps: Step[]; then: Step; text: string; cta: string } };
const booked = [['Thu 2:00', 'Cobalt Freight'], ['Fri 10:30', 'Alder Health'], ['Mon 9:00', 'Juniper Labs']];
---
<section class="sec start" id={s.id}>
  <div class="wrap">
    <div class="head wide"><h2 set:html={rich(s.h2)} /></div>
    <figure class="flow first3" aria-hidden="true">
      <div class="st">
        <div class="fn pic form"><i></i><b></b><i></i><b></b><span>Send</span></div>
        <p class="cap"><em>01</em>{s.steps[0].name}<small>{s.steps[0].time}</small></p>
      </div>
      <div class="st">
        <div class="fn pic call">
          <div class="tiles"><span><b class="av">WJ</b></span><span><b class="av">You</b></span></div>
          <div class="ctl"><i></i><i></i><i class="end"></i></div>
        </div>
        <p class="cap"><em>02</em>{s.steps[1].name}<small>{s.steps[1].time}</small></p>
      </div>
      <div class="st">
        <div class="fn pic file">
          <svg viewBox="0 0 48 60"><path d="M4 2h28l12 12v44H4z" /><path d="M32 2v12h12" /></svg>
          <b class="tag">CSV</b>
          <p>past_clients.csv</p>
        </div>
        <p class="cap"><em>03</em>{s.steps[2].name}<small>{s.steps[2].time}</small></p>
      </div>
      <div class="st then">
        <div class="fn pic meet"><ul>{booked.map(([t, n]) => <li><b>{t}</b>{n}</li>)}</ul></div>
        <p class="cap"><em>Then</em>{s.then.name}<small>{s.then.time}</small></p>
      </div>
    </figure>
    <div class="say">
      <p set:html={rich(s.text)} />
      <a class="btn" href="#apply" data-cta><span>{s.cta}</span><Arrow /></a>
    </div>
  </div>
</section>
