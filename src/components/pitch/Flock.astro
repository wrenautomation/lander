---
// The backdrop on every pitch page and the hub: a loose flock of wrens in faint ink, mostly in the margins, each
// facing into the page. Three depths: near birds are big and move almost with the page, far ones are small, fainter,
// soft, and lag behind as you scroll (parallax). Without motion they sit still. Layout in FLOCK, look in pitch.css.
// Laid out in 1600px bands that alternate between two arrangements down the page, so the density is the same on a
// short page or a long one; bands past the page's end are clipped. x: left edge, % of width. y: px into the band where
// it is met mid-screen. s: width px. k: lag (0 = moves with the page, 1 = fixed). f: -1 faces left. r: tilt.
type Bird = { x: number; y: number; s: number; k: number; f?: number; r?: number };
const BAND = 1600, BANDS = 12;
const LAYOUTS: Bird[][] = [
  [
    { x: -10, y: 150, s: 340, k: 0.18, r: -6 },
    { x: 44, y: 520, s: 64, k: 0.7 },
    { x: 88, y: 700, s: 140, k: 0.45, f: -1, r: 8 },
    { x: 84, y: 1150, s: 320, k: 0.2, f: -1, r: 4 },
    { x: 6, y: 1350, s: 110, k: 0.5, r: 10 },
  ],
  [
    { x: 86, y: 100, s: 360, k: 0.16, f: -1, r: 3 },
    { x: 3, y: 420, s: 150, k: 0.45, r: -5 },
    { x: 55, y: 800, s: 72, k: 0.7, f: -1 },
    { x: -9, y: 1000, s: 300, k: 0.22, r: -8 },
    { x: 30, y: 1250, s: 56, k: 0.75 },
    { x: 90, y: 1400, s: 120, k: 0.5, f: -1, r: 6 },
  ],
];
const FLOCK = Array.from({ length: BANDS }, (_, i) => LAYOUTS[i % LAYOUTS.length].map((b) => ({ ...b, y: i * BAND + b.y }))).flat();
const depth = (k: number) => (k >= 0.6 ? 'far' : k >= 0.4 ? 'mid' : 'near');
---
<div class="flock" aria-hidden="true">
  {FLOCK.map((b) => <i class={depth(b.k)} style={`--x:${b.x}%;--y:${b.y};--s:${b.s};--k:${b.k};--f:${b.f ?? 1};--r:${b.r ?? 0}deg`} />)}
</div>
<script>
  // one custom property per frame; each bird's transform reads it (pitch.css .flock i)
  const flock = document.querySelector<HTMLElement>('.flock');
  if (flock && document.documentElement.classList.contains('js')) {
    let queued = false;
    const move = () => { queued = false; flock.style.setProperty('--sy', String(Math.round(scrollY))); };
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(move); } }, { passive: true });
    move();
  }
</script>
