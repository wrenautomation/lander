---
// What the dead list is worth, from the reader's own numbers. The first answer is computed here, so it reads with JS off.
import type { CollectionEntry } from 'astro:content';
import { rich } from '../../lib/text';
const { c } = Astro.props as { c: NonNullable<CollectionEntry<'pitches'>['data']['calc']> };
const v = Object.fromEntries(c.inputs.map((i) => [i.key, i.value])) as Record<'contacts' | 'fee' | 'rate' | 'fill', number>;
const orders = (v.contacts * v.rate) / 100;
const fees = orders * (v.fill / 100) * v.fee;
const fmt = (x: number, unit: string) =>
  unit === 'usd' ? `$${x >= 1000 ? `${Math.round(x / 1000).toLocaleString('en-US')}k` : Math.round(x)}`
  : unit === 'percent' ? `${x}%` : Math.round(x).toLocaleString('en-US');
---
<section class="sec calc" id="calc">
  <div class="wrap two">
    <div class="head">
      <p class="eyebrow" data-rise>{c.eyebrow}</p>
      <h2 data-rise set:html={rich(c.h2)} />
      <p class="intro" data-rise>{c.intro}</p>
    </div>
    <div class="shell" data-rise><div class="core" data-calc>
      {c.inputs.map((i) => (
        <label class="slider">
          <span class="row"><span>{i.label}</span><output data-out={i.key}>{fmt(i.value, i.unit)}</output></span>
          <input type="range" data-in={i.key} data-unit={i.unit} min={i.min} max={i.max} step={i.step} value={i.value} style={`--p:${((i.value - i.min) / (i.max - i.min)) * 100}%`}>
        </label>
      ))}
      <div class="res">
        <div><b data-res="orders">{fmt(orders, 'count')}</b><span>{c.out_orders}</span></div>
        <div class="hot"><b data-res="fees">{fmt(fees, 'usd')}</b><span>{c.out_fees}</span></div>
      </div>
      <p class="fine">{c.fine}</p>
    </div></div>
  </div>
</section>
