---
// The hub's first two benefits, drawn as node diagrams like the recruiting page's (Flow.astro): more business in
// (an inquiry late at night, answered in minutes, booked) and less busywork out (a signed contract fills the CRM,
// then the invoice, the kickoff and the report go on their own). Names are made up. The markup is the finished
// state; pitch.ts draws the wires (data-edges, "from>to") and plays each in (PLAY.inbound, PLAY.admin).
interface Props { kind: 'inbound' | 'admin' }
const { kind } = Astro.props;

const I = {
  invoice: 'M3.5 1.5h9v13l-2.2-1.3-2.3 1.3-2.3-1.3-2.2 1.3zM6 5h4M6 8h4M6 11h2',
  cal: 'M2.5 3.5h11v10h-11zM2.5 6.5h11M5.5 2v3M10.5 2v3',
  report: 'M2.5 13.5h11M4.5 11V7.5M8 11V4M11.5 11V8.5',
  check: 'M3.5 8.5l3 3 6-7',
};
const outs = [
  { key: 'inv', label: 'Invoice sent', icon: I.invoice },
  { key: 'kick', label: 'Kickoff booked', icon: I.cal },
  { key: 'rep', label: 'Report updated', icon: I.report },
];
const fields = [['Client', 'Harbor Dental'], ['Contact', 'Jordan Kim'], ['Starts', 'Oct 6'], ['Term', '12 months']];
---
{kind === 'inbound' && (
<figure class="flow inbound" data-flow="inbound" data-edges="inq>reply reply>cal" aria-hidden="true">
  <svg class="edges" data-edges-svg></svg>
  <div class="fn inq" data-node="inq" data-in>
    <p class="hd">New inquiry<span>11:48 pm</span></p>
    <div class="from"><span class="av">JK</span><p><b>Jordan Kim</b><span>Harbor Dental, from your site</span></p></div>
    <p class="q">Do you have room for a new client this month?</p>
  </div>
  <div class="fn reply" data-node="reply">
    <p class="hd">Your reply<span class="fast">Sent in 2 min</span></p>
    <p class="body" data-type>Hi Jordan, we do. Pick a time for a 20-minute call and I'll bring a few ideas.</p>
    <div class="times"><i>Tue 10:00</i><i class="pick" data-pick>Wed 2:30</i><i>Thu 9:00</i></div>
  </div>
  <div class="fn booked" data-node="cal" data-out>
    <p class="hd">Your calendar</p>
    <div class="ev"><b>Wed 2:30 pm</b><span>Jordan Kim, Harbor Dental</span></div>
    <p class="note"><i></i>Booked at 11:53 pm</p>
  </div>
</figure>
)}

{kind === 'admin' && (
<figure class="flow admin" data-flow="admin" data-edges={['doc>crm', ...outs.map((o) => `crm>${o.key}`)].join(' ')} aria-hidden="true">
  <svg class="edges" data-edges-svg></svg>
  <div class="fn doc" data-node="doc" data-in>
    <p class="hd">Signed contract<span>9:02 am</span></p>
    <p class="title">Services agreement</p>
    <p class="party">Harbor Dental and your company</p>
    <span class="lines"><i></i><i></i><i></i></span>
    <p class="sig"><b>Jordan Kim</b><em><svg viewBox="0 0 16 16"><path d={I.check} /></svg>Signed</em></p>
  </div>
  <div class="fn rec" data-node="crm">
    <p class="hd">CRM record<span>Nobody typed it</span></p>
    <ul>{fields.map(([k, v]) => <li><span>{k}</span><b>{v}</b></li>)}</ul>
  </div>
  <div class="chs">
    {outs.map((o, k) => <div class="fn ch" data-node={o.key} data-out={k === outs.length - 1 ? '' : undefined}><i><svg viewBox="0 0 16 16"><path d={o.icon} /></svg></i><span>{o.label}</span></div>)}
  </div>
</figure>
)}
