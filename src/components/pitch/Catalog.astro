---
// Every service as a list, grouped by who it's for, the button beside the heading so it all fits one screen; a group with its own page links to it. Each row: a number, the
// name, what it runs on, and a small diagram: one thing going in, the result coming out (green). The markup is the
// finished state; pitch.ts (ART.catalog) plays the rows in, one after another.
import type { CollectionEntry } from 'astro:content';
import { rich } from '../../lib/text';
import Arrow from './Arrow.astro';
import Mini from './Mini.astro';

type C = CollectionEntry<'hub'>['data']['catalog'];
const { s } = Astro.props as { s: C };

let n = 0;
---
<section class="sec catalog" id={s.id}>
  <div class="wrap">
    <div class="head wide"><h2 set:html={rich(s.h2)} /><a class="btn" href="#apply" data-cta><span>{s.cta}</span><Arrow /></a></div>
    <div class="groups" data-art="catalog">
      {s.groups.map((g) => (
        <div class="grp">
          <p class="grp-hd"><span>{g.for}</span>{g.link && <a href={g.link.to}>{g.link.label}<Arrow /></a>}</p>
          <ol>
            {g.items.map((x) => (
              <li class="svc">
                <span class="n">{String(++n).padStart(2, '0')}</span>
                <div class="what"><h3>{x.name}</h3><p>{x.runs}</p></div>
                <Mini in={x.in} out={x.out} />
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </div>
</section>
