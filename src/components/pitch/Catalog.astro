---
// Every service as a list, grouped by who it's for, the button beside the heading so it all fits one screen; a group with its own page links to it. Each row: a number, the
// name, what it runs on, and a small diagram: one thing going in, the result coming out (green). The markup is the
// finished state; pitch.ts (ART.catalog) plays the rows in, one after another.
import type { CollectionEntry } from 'astro:content';
import { rich } from '../../lib/text';
import Arrow from './Arrow.astro';

type C = CollectionEntry<'hub'>['data']['catalog'];
type End = C['groups'][number]['items'][number]['in'];
const { s } = Astro.props as { s: C };

const ICON: Record<End['icon'], string> = {
  person: 'M8 7.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM3 13.5c.8-2.3 2.7-3.5 5-3.5s4.2 1.2 5 3.5',
  mail: 'M2.5 4h11v8.5h-11zM2.5 4.5 8 9l5.5-4.5',
  doc: 'M4 1.5h5.5l3 3v10H4zM9.5 1.5v3h3M6.5 8h4M6.5 11h4',
  cal: 'M2.5 3.5h11v10h-11zM2.5 6.5h11M5.5 2v3M10.5 2v3',
  invoice: 'M3.5 1.5h9v13l-2.2-1.3-2.3 1.3-2.3-1.3-2.2 1.3zM6 5h4M6 8h4M6 11h2',
  check: 'M3.5 8.5l3 3 6-7',
  stack: 'M2.5 3h11v3.5h-11zM2.5 9.5h11V13h-11z',
  record: 'M3 2.5h10v11H3zM5.5 6h5M5.5 9h5',
  search: 'M7 11.5a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9zM10.3 10.3l3.2 3.2',
};
let n = 0;
---
<section class="sec catalog" id={s.id}>
  <div class="wrap">
    <div class="head wide"><h2 set:html={rich(s.h2)} /><a class="btn" href="#apply" data-cta><span>{s.cta}</span><Arrow /></a></div>
    <div class="groups" data-art="catalog">
      {s.groups.map((g) => (
        <div class="grp">
          <p class="grp-hd"><span>{g.for}</span>{g.link && <a href={g.link.to}>{g.link.label}<Arrow /></a>}</p>
          <ol>
            {g.items.map((x) => (
              <li class="svc">
                <span class="n">{String(++n).padStart(2, '0')}</span>
                <div class="what"><h3>{x.name}</h3><p>{x.runs}</p></div>
                <figure class="mini" aria-hidden="true">
                  {[x.in, x.out].map((e, k) => (
                    <>
                      {k === 1 && <span class="wire"><i></i></span>}
                      <div class:list={['nd', k ? 'out' : 'in']}>
                        <i><svg viewBox="0 0 16 16"><path d={ICON[e.icon]} /></svg></i>
                        <span><b>{e.label}</b><em>{e.note}</em></span>
                      </div>
                    </>
                  ))}
                </figure>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </div>
</section>
