---
// The form, in the first screen beside the hero. An offer with an application: contact details first (ask.cta on
// the button), then one question per step, then send. Without one: a contact form. Posts to /api/apply. With JS: fetch, then the calendar, a thank-you or a
// not-a-fit. Without JS: a plain POST that redirects to #applied-fit / #applied-nofit / #applied-error, which CSS
// shows with :target.
import type { CollectionEntry } from 'astro:content';
import { fieldName } from '../../lib/offers';
import { rich } from '../../lib/text';
import Arrow from './Arrow.astro';

type Pitch = CollectionEntry<'pitches'>['data'];
type Offer = CollectionEntry<'offers'>['data'];
const { a, offer, email, path } = Astro.props as { a: Pitch['ask']; offer: Offer; email: string; path: string };
const qs = offer.application?.questions ?? [];
const total = qs.length + 1;
const stepped = qs.length > 0 && !!a.steps;
const turnstile = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---
<div class="panel" id="apply" data-apply data-total={total}>
  <div class="ask">
    <h2>{a.h2}</h2>
    <p class="intro">{a.intro}</p>
    {offer.slots && a.slots && (
      <p class="slots">{Array.from({ length: offer.slots }, () => <i aria-hidden="true"></i>)}<span>{a.slots}</span></p>
    )}
  </div>
  <form method="post" action="/api/apply" data-lead>
    {qs.length > 0 && a.steps && (
      <p class="progress" aria-hidden="true"><span>{a.steps.step} <b data-at>1</b> {a.steps.of} {total}</span><span class="segs">{Array.from({ length: total }, () => <i></i>)}</span></p>
    )}
    <fieldset class="step contact" data-step="0" data-contact>
      {a.steps && <legend>{a.steps.contact_h}</legend>}
      <div class="fields">
        <label class="field"><span>{a.name}</span><input name="name" type="text" autocomplete="name"></label>
        <label class="field"><span>{a.email} <small>{a.required}</small></span><input name="email" type="email" autocomplete="email" required><em class="fe" data-error>{a.bad_email}</em></label>
        <label class="field"><span>{a.phone}</span><input name="phone" type="tel" autocomplete="tel" inputmode="tel"></label>
        {a.firm && <label class="field"><span>{a.firm} <small>{a.required}</small></span><input name="firm" type="text" autocomplete="url" inputmode="url" required><em class="fe" data-error>{a.required}</em></label>}
        {a.note && <label class="field"><span>{a.note}</span><textarea name="note" rows="3"></textarea></label>}
      </div>
      <input type="hidden" name="offer" value={offer.id}>
      <input type="hidden" name="page" value={path}>
      {['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'ref'].map((k) => <input type="hidden" name={k} value="">)}
      <label class="hp" aria-hidden="true">Leave empty<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
      {turnstile && <div class="cf-turnstile" data-sitekey={turnstile} data-size="flexible" data-theme="light"></div>}
      {!stepped && <button class="btn ink" type="submit" data-submit data-sending={a.sending}><span>{a.submit}</span><Arrow /></button>}
    </fieldset>
    {qs.map((q, i) => (
      <fieldset class="step" data-step={i + 1} data-kind={q.kind} data-required={q.required ? '' : undefined}>
        <legend>{q.ask}</legend>
        {q.kind === 'text'
          ? <textarea name={fieldName(q.id)} placeholder={q.placeholder} rows="3"></textarea>
          : <div class:list={['choices', { many: q.kind === 'many' }]}>
              {q.choices.map((c, j) => (
                <label class="choice">
                  <input type={q.kind === 'one' ? 'radio' : 'checkbox'} name={fieldName(q.id)} value={c.id} required={q.kind === 'one' && q.required && j === 0}>
                  <span>{c.label}</span>
                </label>
              ))}
            </div>}
        {a.steps && <p class="fe" data-error>{a.steps.pick_one}</p>}
      </fieldset>
    ))}
    {stepped && (
      <div class="nav-steps">
        <button type="button" class="back" data-back>{a.steps!.back}</button>
        <button type="button" class="btn ink" data-next data-first={a.cta} data-label={a.steps!.next}><span>{a.cta ?? a.steps!.next}</span><Arrow /></button>
        <button class="btn ink" type="submit" data-submit data-sending={a.sending}><span>{a.submit}</span><Arrow /></button>
      </div>
    )}
    {a.assure && <p class="assure">{a.assure}</p>}
  </form>
  <div class="result" id="applied-fit" data-result="fit" tabindex="-1">
    {offer.booking ? (
      <>
        <h3 set:html={rich(a.book_h!)} /><p>{a.book}</p>
        <div class="cal" data-cal data-booking={offer.booking}></div>
        <a class="plain" href={offer.booking} target="_blank" rel="noopener">{offer.booking.replace(/^https:\/\//, '')}</a>
      </>
    ) : (
      <><h3 set:html={rich(a.thanks_h)} /><p>{a.thanks}</p></>
    )}
  </div>
  {a.nofit_h && <div class="result" id="applied-nofit" data-result="nofit" tabindex="-1"><h3 set:html={rich(a.nofit_h)} /><p>{a.nofit}</p></div>}
  <div class="result" id="applied-error" data-result="error" tabindex="-1" role="alert"><p>{a.error} <a href={`mailto:${email}`}>{email}</a></p></div>
</div>
{turnstile && <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>}
