---
// The pain, then the fix, as a letter: salutation, three pains as questions, one line on what the system does (the
// heading), the pain in depth beside it. Then what they don't need and what they do, beside one example playing
// out beat by beat (labelled as one). Ends on the target and a button back to the form. With motion the beats
// light in order and the reel loops while it's on screen; without, every beat is simply there.
import type { CollectionEntry } from 'astro:content';
import { rich } from '../../lib/text';
import Arrow from './Arrow.astro';
import Face from './Face.astro';
type Story = NonNullable<CollectionEntry<'pitches'>['data']['story']>;
const { s } = Astro.props as { s: Story };
const two = (n: number) => String(n).padStart(2, '0');
---
<section class="sec story" id={s.id}>
  <div class="wrap grid">
    <div class="head sticky">
      <p class="dear">{s.dear}</p>
      <ul class="checks qs">{s.questions.map((q) => <li set:html={rich(q)} />)}</ul>
      <h2 set:html={rich(s.answer)} />
    </div>
    <div class="letter">
      {s.pain.map((b) => typeof b === 'string'
        ? <p set:html={rich(b)} />
        : <ul class="checks">{b.map((x) => <li set:html={rich(x)} />)}</ul>)}
    </div>
  </div>
  <div class="wrap grid solve">
    <div class="head sticky letter">
      {s.solve.map((b) => typeof b === 'string'
        ? <p set:html={rich(b)} />
        : <ul class="checks">{b.map((x) => <li set:html={rich(x)} />)}</ul>)}
    </div>
    <figure class="reel" data-reel>
      <figcaption class="label">{s.label}</figcaption>
      <ol>
        {s.beats.map((b, i) => (
          <li class="beat" data-beat data-kind={b.kind}>
            <p class="step"><span>{two(i + 1)}</span>{b.step}</p>
            <div class="card">
              {b.kind === 'row' && (
                <div class="row"><p><b>{b.name}</b><span>{b.role}</span></p><p class="note">{b.note}</p><em class="status">{b.status}</em></div>
              )}
              {b.kind === 'signal' && (
                <div class="signal"><i aria-hidden="true"></i><p><b>{b.text}</b><span>{b.meta}</span></p></div>
              )}
              {b.kind === 'msg' && (
                <div class:list={['msg', b.side]}>
                  <Face name={b.m.name} face={b.m.face} />
                  <div class="body">
                    <p class="who"><b>{b.m.name}</b><span>{b.m.role}</span><time>{b.m.when}</time></p>
                    <p class="txt">{b.m.text}</p>
                  </div>
                </div>
              )}
              {b.kind === 'meet' && (
                <div class="meet"><time>{b.when}</time><p>{b.text}</p><em class="status on">{b.status}</em></div>
              )}
            </div>
          </li>
        ))}
      </ol>
    </figure>
  </div>
  <div class="wrap target">
    <p set:html={rich(s.target)} />
    <a class="btn ink" href="#apply" data-cta><span>{s.cta}</span><Arrow /></a>
  </div>
</section>
