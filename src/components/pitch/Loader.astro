---
// The load screen, first thing in <body> on every pitch page and the hub. A plain gray screen covers the page from the
// first paint, so the page never shows and then gets covered. A load under 900ms just fades it off. A slower one shows
// the mark filling lavender toward 80% with a line under it ("Serving your page", then "Hang tight, almost there" at 3s);
// when the page is ready it fills the rest and the screen lifts as the hero rises (window.wrenShown, read by pitch.ts).
// Ready means the page's three font weights, nothing else: the CSS is already in (this script runs after it) and the
// scripts load on behind it. Kept up at least 400ms once shown so it never flickers; lifts at 4s whatever is still loading.
// Motion only (html.js).
---
<div class="loader" aria-hidden="true"><i class="bird"></i><b></b><p><span>Serving your page</span><span>Hang tight, almost there</span></p></div>
<script is:inline>
  (function(){var h=document.documentElement,res,shown=0,done=0;window.wrenShown=new Promise(function(r){res=r});
  if(!h.classList.contains('js'))return res();
  h.classList.add('loading');
  var t=setTimeout(function(){h.classList.add('slow');shown=performance.now()},900),t2=setTimeout(function(){h.classList.add('slower')},3000);
  function ready(){if(done)return;done=1;clearTimeout(t);clearTimeout(t2);
    if(!shown){h.classList.add('quick');setTimeout(function(){h.classList.remove('loading','quick')},200);return res()}
    setTimeout(function(){h.classList.add('ready');setTimeout(res,250);setTimeout(function(){h.classList.remove('loading','slow','slower','ready')},800)},Math.max(0,400-(performance.now()-shown)))}
  var f=document.fonts;Promise.all(f?[400,500,600].map(function(w){return f.load(w+' 1em "General Sans"')}):[]).then(ready,ready);setTimeout(ready,4000)})();
</script>
