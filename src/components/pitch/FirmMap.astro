---
// The hub's third benefit: a firm's scattered tools wired into one clean CRM, and what that buys. A flow like the
// recruiting page's diagrams, inside the benefits' data-flows box (the line from the diagram above enters at the
// first tool). pitch.ts wires it and plays it in (PLAY.map). Names are made up. The markup is the finished state.
type Map = { from: { h: string; items: string[] }; crm: { h: string; rows: { name: string; note: string }[] }; to: { h: string; items: string[] }[] };
const { m } = Astro.props as { m: Map };
// one plain line icon per tool, by position: inbox, sheet, old database, calendar
const ICONS = [
  'M2 3.5h12v9H2zM2 4.5l6 4.5 6-4.5',
  'M2.5 2.5h11v11h-11zM2.5 6h11M2.5 9.5h11M6.5 2.5v11',
  'M3 4c0-1.1 2.2-2 5-2s5 .9 5 2v8c0 1.1-2.2 2-5 2s-5-.9-5-2zM3 4c0 1.1 2.2 2 5 2s5-.9 5-2M3 8c0 1.1 2.2 2 5 2s5-.9 5-2',
  'M2.5 3.5h11v10h-11zM2.5 6.5h11M5.5 2v3M10.5 2v3',
];
const src = m.from.items.map((label, k) => ({ key: `s${k}`, label, d: ICONS[k % ICONS.length] }));
const goals = m.to.map((g, k) => ({ key: `g${k}`, ...g }));
const edges = [...src.map((s) => `${s.key}>crm`), ...goals.map((g) => `crm>${g.key}`)].join(' ');
---
<figure class="flow map" data-flow="map" data-edges={edges} aria-hidden="true">
    <svg class="edges" data-edges-svg></svg>
    <div class="chs">
      <p class="cap">{m.from.h}</p>
      {src.map((s, k) => <div class="fn ch" data-node={s.key} data-in={k ? undefined : ''}><i><svg viewBox="0 0 16 16"><path d={s.d} /></svg></i><span>{s.label}</span></div>)}
    </div>
    <div class="fn crm" data-node="crm">
      <p class="hd">{m.crm.h}<i class="stamp"></i></p>
      <ul>{m.crm.rows.map((r) => <li><b>{r.name}</b><span>{r.note}</span></li>)}</ul>
    </div>
    <div class="goals">
      {goals.map((g) => (
        <div class="fn goal" data-node={g.key}>
          <p class="hd">{g.h}</p>
          <ul>{g.items.map((x) => <li><i><svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7" /></svg></i>{x}</li>)}</ul>
        </div>
      ))}
    </div>
</figure>
