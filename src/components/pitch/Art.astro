---
// A step's diagram, drawn in code (the `art` union in content.config.ts). Always whole on the page; with motion,
// its parts come in when it scrolls into view (pitch.ts, by data-art).
import type { CollectionEntry } from 'astro:content';
type Art = NonNullable<NonNullable<CollectionEntry<'pitches'>['data']['build']>['stages'][number]['art']>;
const { a } = Astro.props as { a: Art };
---
{a.kind === 'rows' && (
  <ul class="art rows-art" data-art="rows" aria-hidden="true">
    {a.rows.map((r) => <li class={r.mark}><i class="mk"></i><span>{r.text}</span><em>{r.note}</em></li>)}
  </ul>
)}
{a.kind === 'bars' && (
  <ul class="art bars" data-art="bars" aria-hidden="true">
    {a.bars.map((b) => <li class:list={{ hot: b.hot }}><span>{b.label}</span><i style={`--w:${b.w}%`}></i></li>)}
  </ul>
)}
{a.kind === 'merge' && (
  <div class="art merge" data-art="merge" aria-hidden="true">
    <ul>{a.sources.map((x) => <li>{x}</li>)}</ul>
    <svg viewBox="0 0 100 100" preserveAspectRatio="none">
      {a.sources.map((_, k) => { const y = ((k + 0.5) / a.sources.length) * 100; return <path d={`M0 ${y} C 55 ${y}, 45 50, 100 50`} />; })}
    </svg>
    <span class="into"><i></i>{a.into}</span>
  </div>
)}
