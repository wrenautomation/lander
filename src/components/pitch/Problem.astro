---
// The problem, top down in one column: three pains as questions, the fix in one line at the same size, the goal
// and a button back to the form. Then the pain in depth and the fix. A string is a paragraph, a list is a
// checklist, { bad } is a list crossed out.
import { rich } from '../../lib/text';
import Arrow from './Arrow.astro';

type Item = string | string[] | { bad: string[] };
interface Props { s: { id: string; questions: string[]; answer: string; target: string; cta: string; pain: Item[]; fix: Item[] } }
const { s } = Astro.props;
---
<section class="sec problem" id={s.id}>
  <div class="wrap col">
    <ul class="checks qs">{s.questions.map((q) => <li set:html={rich(q)} />)}</ul>
    <h2 set:html={rich(s.answer)} />
    <div class="target">
      <p set:html={rich(s.target)} />
      <a class="btn ink" href="#apply" data-cta><span>{s.cta}</span><Arrow /></a>
    </div>
    {[s.pain, s.fix].map((body, i) => (
      <div class:list={['prose', { fix: i === 1 }]}>
        {body.map((b) =>
          typeof b === 'string' ? <p set:html={rich(b)} />
          : Array.isArray(b) ? <ul class="checks">{b.map((x) => <li set:html={rich(x)} />)}</ul>
          : <ul class="checks crosses">{b.bad.map((x) => <li set:html={rich(x)} />)}</ul>
        )}
      </div>
    ))}
  </div>
</section>
