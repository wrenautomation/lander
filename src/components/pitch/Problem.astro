---
// The problem, as two screens. First, full width: three pains as questions, the fix in one line at the same size,
// the goal. Then, in one column, the pain in depth and a button back to the form. A string is a paragraph, a list is a checklist,
// { bad } is a list crossed out.
import { rich } from '../../lib/text';
import Arrow from './Arrow.astro';

type Item = string | string[] | { bad: string[] };
interface Props { s: { id: string; questions: string[]; answer: string; target: string; cta: string; pain: Item[] } }
const { s } = Astro.props;
---
<section class="sec problem" id={s.id}>
  <div class="wrap">
    <ul class="qs">{s.questions.map((q) => <li set:html={rich(q)} />)}</ul>
    <h2 set:html={rich(s.answer)} />
    <p class="target" set:html={rich(s.target)} />
  </div>
</section>
<section class="sec agitate">
  <div class="wrap">
    <div class="pain">
      {s.pain.map((b) =>
        typeof b === 'string' ? <p set:html={rich(b)} />
        : Array.isArray(b) ? <ul class="checks">{b.map((x) => <li set:html={rich(x)} />)}</ul>
        : <ul class="checks crosses">{b.bad.map((x) => <li set:html={rich(x)} />)}</ul>
      )}
    </div>
    <a class="btn ink" href="#apply" data-cta><span>{s.cta}</span><Arrow /></a>
  </div>
</section>
