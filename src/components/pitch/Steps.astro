---
// A timeline section: the heading sticks, a rule fills as you read, each stop lights when reached (pitch.ts,
// by data-timeline). The pilot's days and the build's stages both render here; the build adds its week chart.
import Art from './Art.astro';
import { rich } from '../../lib/text';
type Item = { when: string; name: string; text: string; art?: Parameters<typeof Art>[0]['a'] };
const { id, h2, intro, items } = Astro.props as { id: string; h2: string; intro: string; items: Item[] };
---
<section class="sec steps" id={id}>
  <div class="wrap grid">
    <div class="head sticky">
      <h2 set:html={rich(h2)} />
      <p class="intro">{intro}</p>
      <slot />
    </div>
    <ol class="timeline" data-timeline>
      <span class="rail" aria-hidden="true"><i data-rail></i></span>
      {items.map((s) => (
        <li data-stop><span class="node" aria-hidden="true"></span><h3>{s.name} <span class="when">{s.when}</span></h3><p>{s.text}</p>{s.art && <Art a={s.art} />}</li>
      ))}
    </ol>
  </div>
</section>
