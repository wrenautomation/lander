---
// The speaker button and volume slider for the page's sounds (src/scripts/sound.ts). Hidden until the script
// runs, and never shown without motion: the sounds ride on the animation.
---
<div class="sound" role="region" aria-label="Sound" data-sound hidden>
  <button type="button" aria-pressed="false" aria-label="Sound off. Turn on">
    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 7.5h3l4-3.5v12l-4-3.5H3z" /><path class="w" d="M13 7a4 4 0 0 1 0 6M15.5 4.5a7.5 7.5 0 0 1 0 11" /><path class="x" d="M13.5 8l4 4M17.5 8l-4 4" /></svg>
  </button>
  <input type="range" min="0" max="100" step="5" value="50" aria-label="Volume" />
</div>
<script src="../scripts/sound.ts"></script>
<style is:global>
  .sound{position:fixed;z-index:50;left:16px;bottom:16px;display:flex;align-items:center;gap:6px;padding:4px;background:rgba(14,14,14,.86);color:#FAF7F2;border-radius:2px}
  html:not(.js) .sound,.sound[hidden]{display:none}
  .sound button{display:grid;place-items:center;width:40px;height:40px;padding:0;background:none;border:0;color:inherit;cursor:pointer}
  .sound svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
  .sound svg path:first-child{fill:currentColor}
  .sound .w{display:none}.sound.on .w{display:inline}.sound.on .x{display:none}
  .sound input{width:0;opacity:0;margin:0;accent-color:#FAF7F2;transition:width .25s,opacity .25s}
  .sound:is(:hover,:focus-within) input{width:88px;opacity:1;margin-right:8px}
  .sound :focus-visible{outline:2px solid #FAF7F2;outline-offset:2px}
</style>
