---
// Cloudflare Pages serves 404.html for any path that does not exist. Copy is in site.yaml.
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import Foot from '../components/Foot.astro';
const site = (await getEntry('site', 'site'))!.data;
---
<Base title={site.notfound_title} description={site.notfound} hue="rust" noindex>
<div class="wrap">
  <nav class="nav" aria-label="Page">
    <a href="/" aria-label="Wren Automation, front page"><Mark /></a>
    <div class="right">
      <button class="theme" type="button" data-theme-toggle data-to-dark={site.theme.to_dark} data-to-light={site.theme.to_light} aria-label="Switch between light and dark">{site.theme.to_dark}</button>
    </div>
  </nav>
</div>
<main>
<section class="hero">
  <div class="wrap">
    <h1>{site.notfound_h}</h1>
    <p class="lede">{site.notfound}</p>
    <a class="btn" href="/">{site.notfound_link}</a>
  </div>
</section>
</main>
<Foot site={site} />
</Base>
