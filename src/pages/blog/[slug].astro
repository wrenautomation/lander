---
// /blog/<slug>: one post from src/content/blog. Under it, the newsletter signup; the same post goes out as the email.
// A thin bar along the top tracks how far down the reader is; the sticky bar under it names the section being read.
// The figures in src/components/blog build as they scroll in (src/scripts/blog.ts). All of it is off under reduced
// motion, and the page reads whole without it.
import type { GetStaticPaths } from 'astro';
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Mark from '../../components/Mark.astro';
import Theme from '../../components/Theme.astro';
import Foot from '../../components/Foot.astro';
import Subscribe from '../../components/Subscribe.astro';
import Compare from '../../components/blog/Compare.astro';
import Note from '../../components/blog/Note.astro';
import Steps from '../../components/blog/Steps.astro';
import Rack from '../../components/blog/Rack.astro';
import Leaks from '../../components/blog/Leaks.astro';
import Fan from '../../components/blog/Fan.astro';
import Hairline from '../../components/Hairline.astro';
import Timeline from '../../components/blog/Timeline.astro';
import Stat from '../../components/blog/Stat.astro';
import { SIGNUP, day, postPath, posts, type Post } from '../../lib/blog';
import '../../styles/blog.css';

export const getStaticPaths = (async () =>
  (await posts()).map((p) => ({ params: { slug: p.id }, props: { post: p } }))) satisfies GetStaticPaths;

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const site = (await getEntry('site', 'site'))!.data;
---
<Base title={`${post.data.title} | Wren Automation`} description={post.data.description} hue="lavender">
<div class="read-bar" aria-hidden="true"></div>
<div class="post-bar">
<div class="wrap">
  <nav class="nav" aria-label="Page">
    <a href="/" aria-label="Wren Automation, front page"><Mark /></a>
    <span class="post-at" data-at aria-hidden="true"></span>
    <div class="right">
      <a href="/blog">Blog</a>
      <Theme to_dark={site.theme.to_dark} to_light={site.theme.to_light} />
    </div>
  </nav>
</div>
</div>
<main>
<article>
  <header class="post-hero">
    <div class="wrap post-head">
      <p class="post-date"><time datetime={post.data.date.toISOString().slice(0, 10)}>{day(post.data.date)}</time>{post.data.draft && ' · draft'}</p>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
    </div>
  </header>
  <section class="s">
    <div class="wrap post"><Content components={{ Compare, Note, Steps, Rack, Leaks, Fan, Timeline, Stat, Hairline }} /></div>
  </section>
</article>
<section class="s">
  <div class="wrap post-signup">
    <Subscribe topic={SIGNUP.topic} text={SIGNUP.text} version={SIGNUP.version} path={postPath(post)} button={SIGNUP.button} />
  </div>
</section>
</main>
<Foot site={site} signup={false} />
<script src="../../scripts/blog.ts"></script>
</Base>
