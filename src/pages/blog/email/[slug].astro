---
// /blog/email/<slug>, dev only: a post as its newsletter email, the way wren's issueMail (packages/channel-email,
// newsletter.ts) builds it: the post title as the subject, the plain text from emailText, the line to the page, then
// the footer. The footer's links are placeholders here; wren fills them per reader at send time. Never built for prod.
import type { GetStaticPaths } from 'astro';
import { emailText, postPath, posts, type Post } from '../../../lib/blog';

export const getStaticPaths = (async () =>
  import.meta.env.DEV ? (await posts()).map((p) => ({ params: { slug: p.id }, props: { post: p } })) : []) satisfies GetStaticPaths;

const { post } = Astro.props as { post: Post };
const url = `https://wrenautomation.com${postPath(post)}`;
const text = `${emailText(post.body ?? '', url)}\n\nOn the site, with the pictures: ${url}`;
const foot = `--\nYou signed up for new posts at wrenautomation.com.\nChange what you get or unsubscribe: https://app.wrenautomation.com/p/...\n(postal address)`;
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex"><title>Email: {post.data.title}</title>
<style>
  body{margin:0;background:#ece9e3;font:15px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#1b1714}
  .mail{max-width:680px;margin:24px auto;background:#fff;border:1px solid #dcd8cf}
  .head{padding:14px 18px;border-bottom:1px solid #e5dfd6;font-size:13px;color:#6d665e}
  .head b{color:#1b1714;font-weight:600}
  .head .subject{font-size:17px;color:#1b1714;font-weight:600;margin-top:6px}
  pre{margin:0;padding:18px;white-space:pre-wrap;word-wrap:break-word;font:14.5px/1.55 ui-monospace,"SF Mono",Menlo,monospace}
  @media (max-width:700px){.mail{margin:0;border:0}}
</style></head>
<body>
<div class="mail">
  <div class="head"><div><b>From</b> Wren Automation &lt;portal@wrenautomation.com&gt;</div><div class="subject">{post.data.title}</div></div>
  <pre>{text}{'\n\n'}{foot}</pre>
</div>
</body>
</html>
