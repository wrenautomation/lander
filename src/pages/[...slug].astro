---
// /ria, /insurance, /agencies: one page per file in src/content/niches. / is index.astro.
import { getCollection } from 'astro:content';
import Lander from '../layouts/Lander.astro';

export async function getStaticPaths() {
  const niches = await getCollection('niches');
  return niches.map((niche) => ({ params: { slug: niche.id }, props: { niche } }));
}
const { niche } = Astro.props;
---
<Lander niche={niche} />
