---
// Pitch pages: one per file in src/content/pitches, at its `path` (/ and /recruiting). Niche pages are [niche].astro,
// a separate route so each layout's CSS stays on its own pages.
import Pitch from '../layouts/Pitch.astro';
import { pitchPaths } from '../lib/pitch';

export async function getStaticPaths() {
  return (await pitchPaths()).map(({ slug, entry }) => ({ params: { slug }, props: { entry } }));
}
---
<Pitch entry={Astro.props.entry} />
